# ============================================================
# HOTEL MANAGEMENT SAAS — ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env.local for local development
# Set these variables in Vercel dashboard for production

# ----------------------------------------------------------
# DATABASE (Neon PostgreSQL — cloud)
# Get this from: https://neon.tech → Project → Connection String
# ----------------------------------------------------------
DATABASE_URL="postgresql://username:password@host.neon.tech/dbname?sslmode=require"

# ----------------------------------------------------------
# JWT AUTHENTICATION SECRET
# Generate with: openssl rand -hex 32
# ----------------------------------------------------------
JWT_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS"

# Scoped public portal sessions (corporate and guest links).
# May be the same as JWT_SECRET, but a separate secret is recommended.
PORTAL_TOKEN_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS"

# Staff attendance QR signing secret.
STAFF_QR_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS"

# Use "mock" only for local/demo guest checkout. Configure a real gateway before production.
PAYMENT_GATEWAY_MODE="mock"

# Internal/mock smart-lock webhook HMAC secret.
LOCK_WEBHOOK_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS"

# Optional Apnacomplex integration credentials.
APNACOMPLEX_API_KEY="REPLACE_WITH_A_LONG_RANDOM_API_KEY"
APNACOMPLEX_JWT_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS"

# ----------------------------------------------------------
# APPLICATION URL (used by Capacitor APK to point to live URL)
# Set this to your Vercel deployment URL after first deploy
# e.g., https://hotel-management-xyz.vercel.app
# ----------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ----------------------------------------------------------
# NODE ENVIRONMENT
# ----------------------------------------------------------
NODE_ENV="development"
