# StayOS Operations Mobile Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# This public environment variable configures the backend HTTPS endpoint.
# NEVER place database credentials, JWT secret keys, or private API keys here.

# Local Development (Android Emulator):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Local Development (Physical Device on Local Wi-Fi):
# EXPO_PUBLIC_API_URL=http://192.168.1.100:3000

# Staging Environment:
# EXPO_PUBLIC_API_URL=https://staging-pms.stayos.com

# Production Environment:
EXPO_PUBLIC_API_URL=https://pms.stayos.com
