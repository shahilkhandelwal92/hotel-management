// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Represents Hotel Properties onboarded onto the system
model Hotel {
  id        String @id @default(uuid())
  name      String
  location  String
  address   String?
  phone     String?
  email     String?
  gstin     String? // Hotel GSTIN for GST billing
  state     String? // Hotel state code for CGST/SGST vs IGST
  roomCount Int    @default(0)
  status    String @default("Active") // Active, Inactive
  timezone  String @default("Asia/Kolkata") // Hotel operational timezone

  hasInHouseRestaurant Boolean @default(true)
  zomatoLink           String?
  swiggyLink           String?
  isTaxApplicable      Boolean @default(false) // Whether tax applies (GST/VAT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  isTaxIncluded   Boolean @default(false) // Tax included in room price

  users               User[]
  events              CorporateEvent[]
  leaveTypes          LeaveType[]
  rooms               Room[]
  amenities           Amenity[]
  amenityBookings     AmenityBooking[]
  menuItems           MenuItem[]
  groceryStock        GroceryStock[]
  eventVenues         EventVenue[]
  financialRep        FinancialReport[]
  taxConfigs          TaxConfiguration[]
  roomCategories      RoomCategory[]
  reservations        Reservation[]
  guestProfiles       GuestCRMProfile[]
  shifts              Shift[]
  announcements       Announcement[]
  invoices            Invoice[]
  housekeeping        HousekeepingTask[]
  lostAndFound        LostAndFound[]
  payrollRecords      PayrollRecord[]
  nightAudits         NightAudit[]
  ratePlans           RatePlan[]
  saasSubscription    SaasSubscription?
  folios              Folio[]
  usageTracking       UsageTracking[]
  roomBlocks          RoomBlock[]
  posOrders           PosOrder[]
  accessCredentials   AccessCredential[]
  accessLogs          AccessLog[]
  staffAttendanceLogs StaffAttendanceLog[]
  userRoles           UserRole[]
  invoiceSequences    InvoiceSequence[]
}

// Handles Super Admins, Hotel Admins, Staff, and Corporate Clients
model User {
  id       String @id @default(uuid())
  email    String @unique
  password String // Hashed password
  salt     String?
  name     String

  hotelId String? // Nullable because Super Admins/Corporate might not belong to a specific hotel
  hotel   Hotel?  @relation(fields: [hotelId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leaveRequests       LeaveRequest[]
  attendances         Attendance[]
  roles               UserRole[]
  auditLogs           AuditLog[]
  salaries            EmployeeSalary[]
  itrs                EmployeeITR[]
  housekeepingTasks   HousekeepingTask[] @relation("HousekeepingAssignee")
  payrollRecords      PayrollRecord[]    @relation("PayrollUser")
  shiftAssignments    ShiftAssignment[]  @relation("ShiftUser")
  announcements       Announcement[]    @relation("AnnouncementAuthor")
  overtimes           Overtime[]         @relation("OvertimeUser")
  salaryRevisions     SalaryRevision[]   @relation("SalaryRevisions")
  appraisals          Appraisal[]        @relation("AppraisalUser")
}


model Role {
  id    String @id @default(uuid())
  name  String @unique // e.g. SUPER_ADMIN, HOTEL_ADMIN, STAFF, KITCHEN, CORPORATE, ACCOUNTING
  
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique // e.g., VIEW_BOOKINGS, EDIT_FINANCIALS, MANAGE_STAFF
  description String?

  roles       RolePermission[]
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  role         Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserRole {
  id      String @id @default(uuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId  String
  role    Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  hotelId String?
  hotel   Hotel?  @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  
  @@unique([userId, roleId, hotelId])
}

// Stores dynamic subscriptions for properties
model Subscription {
  id        String   @id @default(uuid())
  hotelId   String
  planName  String // e.g., Basic, Premium, Enterprise
  amount    Decimal  @db.Decimal(18, 2)
  status    String // Active, Cancelled
  startDate DateTime
  endDate   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// CRM Hotel Leads for Enterprise Pipeline
model HotelLead {
  id             String   @id @default(uuid())
  hotelName      String
  contactPerson  String
  contactEmail   String?
  contactMobile  String?
  estimatedValue Decimal  @default(0) @db.Decimal(18, 2)
  notes          String?
  status         String   @default("Scratch") // Scratch, Qualified, Demo, Proposal, ClosedWon, ClosedLost

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Corporate Events & Conferences
model CorporateEvent {
  id            String   @id @default(uuid())
  hotelId       String
  hotel         Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name          String // e.g., Annual Tech Summit 2026
  clientName    String   @default("Corporate Client")
  corporateName String?  // Alias for clientName
  startDate     DateTime @default(now())
  endDate       DateTime @default(now())
  date          DateTime? // Alias for single-day query
  expectedCount Int?     @default(0)
  accessCode    String?  @unique
  status        String   @default("Upcoming") // Upcoming, Ongoing, Completed, Cancelled

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guests CorporateGuest[]
  orders FoodOrder[]
}

// Guests invited to or attending corporate events
model CorporateGuest {
  id          String   @id @default(uuid())
  eventId     String
  event       CorporateEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String
  email       String?
  phone       String?
  designation String?
  company     String?
  roomNumber  String? // Assigned room if staying overnight
  dietaryPref String? // Veg, Non-Veg, Vegan, Jain, etc.

  qrCode         String? // Unique QR access code for check-in
  isSeated       Boolean   @default(false)
  status         String    @default("Registered")
  attendanceTime DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requests GuestRequest[]
}

// HR – Employee Leaves
model LeaveType {
  id          String @id @default(uuid())
  hotelId     String
  hotel       Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name        String // Casual Leave, Sick Leave, Paid Leave
  maxDays     Int    @default(12)
  defaultDays Int?   @default(12)

  leaveRequests LeaveRequest[]
}

model LeaveRequest {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  startDate   DateTime
  endDate     DateTime
  reason      String
  status      String    @default("Pending") // Pending, Approved, Rejected

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// HR – Attendance Management
model Attendance {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  status    String // Present, Absent, HalfDay, Leave
  checkIn   DateTime?
  checkOut  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}

// Property Rooms
model Room {
  id          String   @id @default(uuid())
  hotelId     String
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  number      String
  type        String // Single, Double, Deluxe, Suite, Villa
  price       Decimal  @db.Decimal(18, 2)
  status      String   @default("Vacant") // Vacant, Occupied, Dirty, Cleaning, Maintenance, OutOfService
  floor       Int      @default(1)
  amenities   String?  // JSON string or comma-separated list of amenities
  lastCleaned DateTime?

  categoryId  String?
  category    RoomCategory? @relation(fields: [categoryId], references: [id])

  reservations      Reservation[]
  roomBlocks        RoomBlock[]
  housekeepingTasks HousekeepingTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hotelId, number])
}

// Property Amenities (Spa, Pool, Gym, etc.)
model Amenity {
  id          String   @id @default(uuid())
  hotelId     String
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Decimal  @db.Decimal(18, 2)
  capacity    Int      @default(10)
  status      String   @default("Available") // Available, Maintenance, Closed

  isTaxApplicable Boolean @default(true)
  pricingType     String  @default("FIXED") // FREE, FIXED, HOURLY, PER_PERSON

  bookings AmenityBooking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AmenityBooking {
  id            String   @id @default(uuid())
  hotelId       String
  hotel         Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  amenityId     String
  amenity       Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  guestName     String
  guestPhone    String?
  guestContact  String?
  roomNumber    String?
  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  date          DateTime?
  startTime     DateTime
  endTime       DateTime
  totalAmount   Decimal  @db.Decimal(18, 2)
  paymentStatus String   @default("Unpaid")
  status        String   @default("Confirmed") // Confirmed, Completed, Cancelled

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// In-House Restaurant & Kitchen Menu
model MenuItem {
  id          String   @id @default(uuid())
  hotelId     String
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name        String
  category    String // Starters, Main Course, Desserts, Beverages
  price       Decimal  @db.Decimal(18, 2)
  isVeg       Boolean  @default(true)
  isAvailable Boolean  @default(true)
  description String?
  spiceLevel  String?

  posOrderItems PosOrderItem[] @relation("PosMenuItems")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Kitchen Inventory & Grocery Tracking
model GroceryStock {
  id        String   @id @default(uuid())
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  item      String   @default("") // Rice, Cooking Oil, Milk, Flour
  itemName  String   @default("") // Alias for compatibility
  category  String   @default("General") // Grains, Dairy, Spices, Vegetables
  quantity  Float // in kg/liters/units
  unit      String // kg, ltr, pcs, pkt
  minAlert  Float // Trigger low stock alert if below this

  movements GroceryStockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Room Service & Event Food Orders
model FoodOrder {
  id          String   @id @default(uuid())
  eventId     String?
  event       CorporateEvent? @relation(fields: [eventId], references: [id], onDelete: Cascade)
  roomNumber  String?
  guestName   String
  items       Json // JSON Array of items { name, quantity, price }
  totalAmount Decimal  @db.Decimal(18, 2)
  status      String   @default("Pending") // Pending, Preparing, Delivered, Cancelled

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Guest Services & Dynamic Concierge Requests
model GuestRequest {
  id               String          @id @default(uuid())
  guestId          String?
  guest            CorporateGuest? @relation(fields: [guestId], references: [id], onDelete: Cascade)
  reservationId    String?
  reservation      Reservation?    @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  type             String // Extra Bed, Laundry, Housekeeping, Cab, Custom
  details          String
  status           String          @default("Pending") // Pending, InProgress, Completed, Rejected
  chargeToRoom     Boolean         @default(false)
  amount           Decimal         @default(0) @db.Decimal(18, 2) // Added by staff upon approval

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Event Banquets, Conference Halls & Lawns
model EventVenue {
  id              String   @id @default(uuid())
  hotelId         String
  hotel           Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name            String
  capacity        Int
  basePricePerDay Decimal  @db.Decimal(18, 2) // Base rental fee
  decorationPrice Decimal  @default(0) @db.Decimal(18, 2) // Fixed standard decoration charge
  foodPerPerson   Decimal  @default(0) @db.Decimal(18, 2) // Catering cost per head
  isAvailable     Boolean  @default(true)

  bookings PartyBooking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Banquets, Weddings, Birthdays & Gala Dinners
model PartyBooking {
  id            String     @id @default(uuid())
  venueId       String
  venue         EventVenue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  clientName    String
  clientPhone   String
  clientEmail   String?
  eventType     String // Wedding, Birthday, Corporate Gala, Anniversary
  eventDate     DateTime
  guestsCount   Int
  cateringOpted Boolean    @default(true)
  decorOpted    Boolean    @default(false)
  specialNotes  String?
  estimatedCost Decimal    @db.Decimal(18, 2)
  status        String     @default("Confirmed") // Pending, Confirmed, Cancelled

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Financial P&L Records
model FinancialReport {
  id            String   @id @default(uuid())
  hotelId       String
  hotel         Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  month         String // e.g., "2026-03"
  totalRevenue  Decimal  @default(0) @db.Decimal(18, 2)
  totalExpenses Decimal  @default(0) @db.Decimal(18, 2)
  netProfit     Decimal  @default(0) @db.Decimal(18, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hotelId, month])
}

// System Audit Logs
model AuditLog {
  id          String   @id @default(uuid())
  hotelId     String?
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  module      String   // "Invoice", "Payroll", "Reservation", "Room", "User"
  action      String   // "CREATE", "UPDATE", "DELETE", "APPROVE", "CHECKIN", "CHECKOUT"
  entityType  String?  // Model name for reference
  entityId    String?  // ID of the affected record
  oldValue    Json?    // Snapshot before change
  newValue    Json?    // Snapshot after change
  details     String?  // Free-text notes
  ipAddress   String?
  userAgent   String?  // For fraud detection & debugging

  createdAt   DateTime @default(now())

  @@index([hotelId, createdAt])
  @@index([userId, createdAt])
  @@index([entityId])
}

// Accounting & Tax Configuration
model TaxConfiguration {
  id                    String   @id @default(uuid())
  hotelId               String
  hotel                 Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  financialYear         String   // e.g., "2025-2026"
  taxType               String   @default("GST") // e.g., GST, VAT
  taxRegistrationNumber String?  // e.g., GSTIN
  companyState          String?  // To compute CGST+SGST vs IGST
  
  // Tax percents
  roomTaxPct            Float    @default(0)
  restaurantTaxPct      Float    @default(0)
  barTaxPct             Float    @default(0)
  amenityTaxPct         Float    @default(0)
  tdsPct                Float    @default(0)

  // Is tax applicable overall for this year?
  isTaxApplicable       Boolean  @default(true) 

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([hotelId, financialYear]) // Only one config per hotel per year
}

// Internal HR & Owner Resources
model EmployeeSalary {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month          String   // e.g., "2026-03"
  basicSalary    Decimal  @default(0) @db.Decimal(18, 2)
  allowances     Decimal  @default(0) @db.Decimal(18, 2)
  deductions     Decimal  @default(0) @db.Decimal(18, 2)
  netSalary      Decimal  @default(0) @db.Decimal(18, 2)
  paymentStatus  String   @default("UNPAID") // UNPAID, PAID
  paymentDate    DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, month])
}

model EmployeeITR {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  financialYear  String   // e.g., "2025-2026"
  documentUrl    String?  // Link to ITR PDF/doc
  status         String   @default("PENDING") // PENDING, FILED
  filedDate      DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, financialYear])
}

// ─────────────────────────────────────────────────────────────
// PMS – ROOM CATEGORIES
// ─────────────────────────────────────────────────────────────
model RoomCategory {
  id           String @id @default(uuid())
  name         String // e.g., Deluxe, Suite, Standard
  description  String?
  basePrice    Decimal  @default(0) @db.Decimal(18, 2)
  maxOccupancy Int    @default(2)
  hotelId      String
  hotel        Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  rooms        Room[]
}

// ─────────────────────────────────────────────────────────────
// PMS – RESERVATIONS
// ─────────────────────────────────────────────────────────────
model Reservation {
  id              String   @id @default(uuid())
  bookingRef      String   @unique @default(uuid()) // Human-readable ref
  hotelId         String
  hotel           Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomId          String?
  room            Room?    @relation(fields: [roomId], references: [id])

  // Guest info (may or may not be in GuestCRMProfile)
  guestName       String
  guestEmail      String?
  guestPhone      String
  guestAddress    String?
  guestCity       String?
  guestState      String?  // Used for CGST/SGST vs IGST determination
  guestGstin      String?  // For B2B GST
  idType          String?  // Aadhaar, Passport, DL
  idNumber        String?

  // Booking details
  bookingType     String   @default("Individual") // Individual, Group, Corporate, Walkin
  ratePlan        String   @default("Standard") // Standard, Corporate, OTA
  ratePlanId      String?  // FK to RatePlan table
  adults          Int      @default(1)
  children        Int      @default(0)

  checkIn         DateTime
  checkOut        DateTime
  actualCheckIn   DateTime?
  actualCheckOut  DateTime?

  baseAmount      Decimal  @default(0) @db.Decimal(18, 2)
  taxAmount       Decimal  @default(0) @db.Decimal(18, 2)
  totalAmount     Decimal  @default(0) @db.Decimal(18, 2)
  advanceDeposit  Decimal  @default(0) @db.Decimal(18, 2)
  balanceDue      Decimal  @default(0) @db.Decimal(18, 2)

  includesBreakfast Boolean @default(false)
  includesDinner    Boolean @default(false)
  specialRequests   String?

  status          String   @default("Confirmed") // Confirmed, CheckedIn, CheckedOut, Cancelled, NoShow
  deletedAt       DateTime? // Soft delete

  // Self check-in / check-out timestamps (guest-initiated)
  selfCheckInAt   DateTime?
  selfCheckOutAt  DateTime?

  // Relations
  guestProfileId  String?
  guestProfile    GuestCRMProfile? @relation(fields: [guestProfileId], references: [id])
  invoices        Invoice[]
  folios          Folio[]
  accessCredentials AccessCredential[]
  guestRequests     GuestRequest[]
  amenityBookings   AmenityBooking[]
  posOrders         PosOrder[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([hotelId, checkIn, status])
  @@index([hotelId, status])
  @@index([hotelId, checkOut])
  @@index([roomId, checkIn])
  @@index([deletedAt])
}

// ─────────────────────────────────────────────────────────────
// HOUSEKEEPING
// ─────────────────────────────────────────────────────────────
model HousekeepingTask {
  id            String   @id @default(uuid())
  hotelId       String
  hotel         Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomId        String?
  room          Room?    @relation(fields: [roomId], references: [id])
  roomNumber    String
  taskType      String   @default("Clean") // Clean, Inspect, Turndown, Maintenance
  priority      String   @default("Normal") // Low, Normal, High, Urgent
  assignedToId  String?
  assignedTo    User?    @relation("HousekeepingAssignee", fields: [assignedToId], references: [id])
  checklist     Json? // Array of { item: string, done: boolean }
  notes         String?
  status        String   @default("Pending") // Pending, InProgress, Completed, Skipped
  completedAt   DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model LostAndFound {
  id            String   @id @default(uuid())
  hotelId       String
  hotel         Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  itemName      String
  description   String?
  foundLocation String?
  foundDate     DateTime @default(now())
  foundByName   String?
  guestName     String?
  guestContact  String?
  status        String   @default("Found") // Found, Claimed, Disposed
  estimatedValue Decimal @default(0) @db.Decimal(18, 2)
  resolvedAt    DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// BILLING & GST ENGINE
// ─────────────────────────────────────────────────────────────
model Invoice {
  id              String   @id @default(uuid())
  invoiceNumber   String   @unique
  invoiceType     String   @default("TAX") // TAX, PROFORMA, CREDIT_NOTE, DEBIT_NOTE, ADVANCE, REFUND
  hotelId         String
  hotel           Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  reservationId   String?
  reservation     Reservation? @relation(fields: [reservationId], references: [id])

  // Billing party
  billedToName    String
  billedToEmail   String?
  billedToPhone   String?
  billedToAddress String?
  billedToGstin   String?
  billedToState   String?  // Used for CGST/SGST vs IGST

  // GST breakdown
  subTotal        Decimal  @default(0) @db.Decimal(18, 2)
  cgst            Decimal  @default(0) @db.Decimal(18, 2) // 50% of GST for intra-state
  sgst            Decimal  @default(0) @db.Decimal(18, 2) // 50% of GST for intra-state
  igst            Decimal  @default(0) @db.Decimal(18, 2) // 100% of GST for inter-state
  totalTax        Decimal  @default(0) @db.Decimal(18, 2)
  grandTotal      Decimal  @default(0) @db.Decimal(18, 2)
  roundOff        Decimal  @default(0) @db.Decimal(18, 2)

  // GST Advanced Fields
  invoiceFormat   String   @default("B2C") // B2B, B2C
  isReverseCharge Boolean  @default(false) // RCM applicable
  isExempt        Boolean  @default(false) // GST exempt (hospital/edu)

  // Credit Note / Debit Note linkage (self-relation)
  creditNoteForId String?  // Points to original invoice
  creditNoteFor   Invoice? @relation("CreditNoteRelation", fields: [creditNoteForId], references: [id])
  creditNotes     Invoice[] @relation("CreditNoteRelation")

  status          String   @default("Unpaid") // Unpaid, Partial, Paid, Cancelled
  notes           String?
  dueDate         DateTime?
  deletedAt       DateTime?

  items           InvoiceItem[]
  payments        Payment[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([hotelId, createdAt])
  @@index([hotelId, createdAt, status])  // GST report: date + status filter
  @@index([hotelId, status])             // billing status dashboard
  @@index([status, dueDate])
  @@index([deletedAt])
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  itemType    String  // Room, Food, Amenity, Event, Service, Other
  description String
  hsnSac      String? // HSN for goods, SAC for services
  quantity    Float   @default(1)
  unitPrice   Decimal @db.Decimal(18, 2)
  discount    Decimal @default(0) @db.Decimal(18, 2)
  taxRate     Float   @default(0)
  taxAmount   Decimal @default(0) @db.Decimal(18, 2)
  // Stored GST breakup (avoid recalculation for audits)
  cgstAmount  Decimal? @default(0) @db.Decimal(18, 2)
  sgstAmount  Decimal? @default(0) @db.Decimal(18, 2)
  igstAmount  Decimal? @default(0) @db.Decimal(18, 2)
  lineTotal   Decimal @db.Decimal(18, 2)
}

model Payment {
  id                    String   @id @default(uuid())
  hotelId               String?  // For index queries
  invoiceId             String
  invoice               Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount                Decimal  @db.Decimal(18, 2)
  paymentMode           String   // Cash, Card, UPI, Wallet, Cheque, BankTransfer
  paymentGateway        String?  // Razorpay, PhonePe, Paytm, Stripe, Manual
  transactionRef        String?  // Internal reference
  gatewayTransactionId  String?  // Gateway's transaction ID (for reconciliation)
  reconciliationStatus  String   @default("Pending") // Pending, Reconciled, Failed, Disputed
  settledAt             DateTime?
  notes                 String?
  paidAt                DateTime @default(now())

  createdAt     DateTime @default(now())

  @@index([hotelId, createdAt])
}

// Atomic Sequence Generator for Invoices (Race-condition safe)
model InvoiceSequence {
  id            String   @id @default(uuid())
  hotelId       String
  hotel         Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  financialYear String
  prefix        String   @default("INV")
  nextNumber    Int      @default(1)
  updatedAt     DateTime @updatedAt

  @@unique([hotelId, financialYear, prefix])
  @@index([hotelId, financialYear])
}

// ─────────────────────────────────────────────────────────────
// PAYROLL MODULE (greytHR-like)
// ─────────────────────────────────────────────────────────────
model PayrollRecord {
  id              String   @id @default(uuid())
  hotelId         String
  hotel           Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation("PayrollUser", fields: [userId], references: [id], onDelete: Cascade)
  month           String   // e.g., "2026-03"

  // Earnings
  basicSalary     Decimal  @default(0) @db.Decimal(18, 2)
  hra             Decimal  @default(0) @db.Decimal(18, 2)
  conveyance      Decimal  @default(0) @db.Decimal(18, 2)
  medicalAllowance Decimal @default(0) @db.Decimal(18, 2)
  otherAllowances Decimal  @default(0) @db.Decimal(18, 2)
  overtime        Decimal  @default(0) @db.Decimal(18, 2)
  bonus           Decimal  @default(0) @db.Decimal(18, 2)
  incentives      Decimal  @default(0) @db.Decimal(18, 2)
  grossSalary     Decimal  @default(0) @db.Decimal(18, 2)

  // Statutory deductions
  pf              Decimal  @default(0) @db.Decimal(18, 2) // Provident Fund (12% of basic)
  esi             Decimal  @default(0) @db.Decimal(18, 2) // ESI (0.75% if gross < 21000)
  pt              Decimal  @default(0) @db.Decimal(18, 2) // Professional Tax (state slab)
  tds             Decimal  @default(0) @db.Decimal(18, 2) // Income Tax deduction
  otherDeductions Decimal  @default(0) @db.Decimal(18, 2)
  totalDeductions Decimal  @default(0) @db.Decimal(18, 2)

  netSalary       Decimal  @default(0) @db.Decimal(18, 2)
  workingDays     Int      @default(26)
  lopDays         Int      @default(0) // Loss of Pay days

  paymentStatus   String   @default("Draft") // Draft, Approved, Paid
  paymentDate     DateTime?
  approvedById    String?
  remarks         String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, month])
}

// ─────────────────────────────────────────────────────────────
// CRM – GUEST MANAGEMENT
// ─────────────────────────────────────────────────────────────
model GuestCRMProfile {
  id              String   @id @default(uuid())
  hotelId         String
  hotel           Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name            String
  email           String?
  phone           String
  address         String?
  city            String?
  state           String?
  country         String   @default("India")
  gstin           String?
  dateOfBirth     DateTime?
  anniversary     DateTime?
  nationality     String?
  idType          String?
  idNumber        String?

  segment         String   @default("Leisure") // Leisure, Corporate, VIP, Group
  preferences     Json? // Room type, floor, dietary, etc.
  loyaltyPoints   Int      @default(0)
  totalStays      Int      @default(0)
  totalSpend      Decimal  @default(0) @db.Decimal(18, 2)

  reservations    Reservation[]
  loyaltyLedger   LoyaltyTransaction[]
  complaints      GuestComplaint[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model LoyaltyTransaction {
  id              String   @id @default(uuid())
  guestProfileId  String
  guestProfile    GuestCRMProfile @relation(fields: [guestProfileId], references: [id], onDelete: Cascade)
  points          Int      // Positive = earned, Negative = redeemed
  type            String   // Earn, Redeem, Adjust, Expire
  reason          String?
  referenceId     String?  // Invoice/booking ref

  createdAt       DateTime @default(now())
}

model GuestComplaint {
  id              String   @id @default(uuid())
  guestProfileId  String?
  guestProfile    GuestCRMProfile? @relation(fields: [guestProfileId], references: [id])
  guestName       String
  guestContact    String?
  hotelId         String?
  department      String?  // Housekeeping, F&B, Front Desk, Maintenance
  subject         String
  description     String?
  priority        String   @default("Normal") // Low, Normal, High, Urgent
  status          String   @default("Open") // Open, InProgress, Resolved, Closed
  assignedToId    String?
  resolution      String?
  resolvedAt      DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// HR – SHIFT MANAGEMENT
// ─────────────────────────────────────────────────────────────
model Shift {
  id          String   @id @default(uuid())
  hotelId     String
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name        String   // e.g., "Morning", "Evening", "Night"
  startTime   String   // "06:00"
  endTime     String   // "14:00"
  color       String   @default("#4f46e5")

  assignments ShiftAssignment[]
}

model ShiftAssignment {
  id        String   @id @default(uuid())
  shiftId   String
  shift     Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("ShiftUser", fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime // The specific date for this assignment

  @@unique([userId, date])
}

// ─────────────────────────────────────────────────────────────
// ANNOUNCEMENTS
// ─────────────────────────────────────────────────────────────
model Announcement {
  id          String   @id @default(uuid())
  hotelId     String?
  hotel       Hotel?   @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  title       String
  body        String
  audience    String   @default("All") // All, Staff, Admin, Department
  department  String?
  priority    String   @default("Normal") // Normal, Important, Urgent
  publishedAt DateTime @default(now())
  expiresAt   DateTime?
  createdById String?
  createdBy   User?    @relation("AnnouncementAuthor", fields: [createdById], references: [id])

  createdAt   DateTime @default(now())
