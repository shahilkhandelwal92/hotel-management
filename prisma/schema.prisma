// ─────────────────────────────────────────────────────────────
// NIGHT AUDIT SYSTEM (Hotel Finance Critical)
// ─────────────────────────────────────────────────────────────
model NightAudit {
  id              String   @id @default(uuid())
  hotelId         String
  hotel           Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  auditDate       DateTime
  closedById      String?  // User who closed the day
  closedAt        DateTime?
  status          String   @default("Open") // Open, Closed, Reopened
  isDayClosed     Boolean  @default(false)   // Flag to lock edits for that day

  // Auto-posted revenue summary
  roomRevenue     Decimal  @default(0) @db.Decimal(18, 2)
  fbRevenue       Decimal  @default(0) @db.Decimal(18, 2)
  amenityRevenue  Decimal  @default(0) @db.Decimal(18, 2)
  eventRevenue    Decimal  @default(0) @db.Decimal(18, 2)
  otherRevenue    Decimal  @default(0) @db.Decimal(18, 2)
  totalRevenue    Decimal  @default(0) @db.Decimal(18, 2)
  totalDeductions Decimal  @default(0) @db.Decimal(18, 2) // Refunds, discounts

  // Occupancy snapshot
  occupiedRooms   Int      @default(0)
  totalRooms      Int      @default(0)
  occupancyPct    Float    @default(0)

  notes           String?
  reopenedById    String?
  reopenedAt      DateTime?
  reopenReason    String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([hotelId, auditDate])
  @@index([hotelId, auditDate])
}

// ─────────────────────────────────────────────────────────────
// FOLIO SYSTEM (Running Guest Ledger)
// ─────────────────────────────────────────────────────────────
model Folio {
  id              String   @id @default(uuid())
  hotelId         String
  hotel           Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  reservationId   String
  reservation     Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  folioType       String   @default("Room") // Room, Company, Split, Miscellaneous
  balance         Decimal  @default(0) @db.Decimal(18, 2) // Running balance (positive = guest owes)
  status          String   @default("Open") // Open, Closed, Transferred

  transactions    FolioTransaction[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([reservationId])
  @@index([hotelId])
}

model FolioTransaction {
  id              String   @id @default(uuid())
  folioId         String
  folio           Folio    @relation(fields: [folioId], references: [id], onDelete: Cascade)
  type            String   // Charge, Payment, Refund, Adjustment, Transfer, Opening
  description     String
  amount          Decimal  @db.Decimal(18, 2) // Positive = charge/debit, Negative = credit/payment
  referenceId     String?  // invoiceId, paymentId, etc.
  paymentMode     String?  // Cash, Card, UPI, BankTransfer, Online
  nightAuditId    String?  // Auto-posted by night audit
  postedById      String?  // Staff who posted
  postedAt        DateTime @default(now())

  createdAt       DateTime @default(now())

  @@index([folioId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// ROOM BLOCK (Overbooking Prevention)
// ─────────────────────────────────────────────────────────────
model RoomBlock {
  id              String   @id @default(uuid())
  hotelId         String
  hotel           Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomId          String
  room            Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  date            DateTime
  reservationId   String?  // Which reservation holds this block

  @@unique([roomId, date])
  @@index([roomId, date])
}

// ─────────────────────────────────────────────────────────────
// RATE PLAN ENGINE
// ─────────────────────────────────────────────────────────────
model RatePlan {
  id                  String   @id @default(uuid())
  hotelId             String
  hotel               Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name                String   // e.g., "Peak Season Corporate"
  code                String   // PEAK, CORP, WKD, OTA
  description         String?
  baseMultiplier      Float    @default(1.0) // Multiplied on base room price
  cancellationHours   Int      @default(24)  // Hours before check-in for free cancel
  refundPolicy        String   @default("FullRefund48h") // FullRefund48h, NoRefund, PartialRefund
  mealPlan            String   @default("RO") // RO (Room Only), CP, MAP, AP
  isActive            Boolean  @default(true)

  rules               RatePlanRule[]
  seasonalRates       SeasonalRate[]

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([hotelId, code])
}

model RatePlanRule {
  id          String   @id @default(uuid())
  ratePlanId  String
  ratePlan    RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)
  ruleType    String   // Weekend, Weekday, MinStay, MaxStay, EarlyBird, LongStay
  multiplier  Float    @default(1.0) // Applied on top of base multiplier
  value       String?  // e.g. "2" for MinStay 2 nights
}

model SeasonalRate {
  id          String   @id @default(uuid())
  ratePlanId  String
  ratePlan    RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)
  name        String   // "Diwali Peak", "Summer Off-Season"
  startDate   DateTime
  endDate     DateTime
  multiplier  Float    @default(1.0)
  isActive    Boolean  @default(true)
}

// ─────────────────────────────────────────────────────────────
// SAAS PLATFORM LAYER
// ─────────────────────────────────────────────────────────────

// Normalized features table (avoids typo-based bugs)
model Feature {
  id          String   @id @default(uuid())
  code        String   @unique // "PMS", "POS", "PAYROLL", "CRM", "EVENTS", "ANALYTICS"
  name        String             // Display name
  description String?

  planFeatures SaasPlanFeature[]
}

model SaasPlan {
  id            String   @id @default(uuid())
  name          String   @unique  // "starter", "growth", "enterprise"
  displayName   String            // "Starter", "Growth", "Enterprise"
  priceMonthly  Decimal  @default(0) @db.Decimal(18, 2)
  priceAnnual   Decimal  @default(0) @db.Decimal(18, 2)
  maxHotels     Int      @default(1)
  maxUsers      Int      @default(10)
  maxRooms      Int      @default(50)
  isActive      Boolean  @default(true)

  features      SaasPlanFeature[]
  subscriptions SaasSubscription[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SaasPlanFeature {
  id        String   @id @default(uuid())
  planId    String
  plan      SaasPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  featureId String
  feature   Feature  @relation(fields: [featureId], references: [id], onDelete: Cascade)
  enabled   Boolean  @default(true)
  limitValue Int?    // Optional: e.g., max POS terminals allowed

  @@unique([planId, featureId])
}

model SaasSubscription {
  id                   String   @id @default(uuid())
  hotelId              String   @unique
  hotel                Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  planId               String
  plan                 SaasPlan @relation(fields: [planId], references: [id])
  status               String   @default("Trial") // Trial, Active, Suspended, Cancelled, PastDue
  billingCycle         String   @default("Monthly") // Monthly, Annual
  trialEndsAt          DateTime?
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean  @default(false)
  cancelledAt          DateTime?

  saasInvoices         SaasInvoice[]

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([status])
}

model SaasInvoice {
  id              String           @id @default(uuid())
  subscriptionId  String
  subscription    SaasSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  invoiceNumber   String           @unique
  amount          Decimal          @db.Decimal(18, 2)
  currency        String           @default("INR")
  status          String           @default("Unpaid") // Unpaid, Paid, Failed, Waived
  billingPeriod   String           // "2026-03" (month or period label)
  dueDate         DateTime
  paidAt          DateTime?
  notes           String?

  payments        SaasPayment[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SaasPayment {
  id              String      @id @default(uuid())
  saasInvoiceId   String
  saasInvoice     SaasInvoice @relation(fields: [saasInvoiceId], references: [id], onDelete: Cascade)
  amount          Decimal     @db.Decimal(18, 2)
  paymentMethod   String      // Razorpay, Stripe, BankTransfer, Manual
  transactionId   String?     // Gateway transaction ID
  status          String      @default("Success") // Success, Failed, Refunded
  paidAt          DateTime?

  createdAt       DateTime    @default(now())
}

// ─────────────────────────────────────────────────────────────
// USAGE TRACKING (Plan Enforcement)
// ─────────────────────────────────────────────────────────────
model UsageTracking {
  id        String   @id @default(uuid())
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  metric    String   // "rooms", "users", "reservations", "storage_mb", "invoices"
  value     Int      @default(0)
  period    String   // "2026-03" (month-year)

  updatedAt DateTime @updatedAt

  @@unique([hotelId, metric, period])
  @@index([hotelId, metric])
}

// ─────────────────────────────────────────────────────────────
// POS MODULE – ORDERS
// ─────────────────────────────────────────────────────────────
model PosOrder {
  id            String   @id @default(uuid())
  hotelId       String
  hotel         Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  tableNumber   String?
  orderSource   String   @default("Walkin") // Walkin, InHouse, Event, RoomService
  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  guestName     String?
  kotPrinted    Boolean  @default(false)
  subtotal      Decimal  @default(0) @db.Decimal(18, 2)
  gstAmount     Decimal  @default(0) @db.Decimal(18, 2)
  grandTotal    Decimal  @default(0) @db.Decimal(18, 2)
  discount      Decimal  @default(0) @db.Decimal(18, 2)
  paymentStatus String   @default("Unpaid") // Unpaid, Paid, Folio
  paymentMode   String?
  status        String   @default("Pending") // Pending, Preparing, Ready, Served, Completed, Cancelled
  completedAt   DateTime?
  items         PosOrderItem[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([hotelId, status])
  @@index([hotelId, createdAt])
}

model PosOrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       PosOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId  String
  menuItem    MenuItem @relation(name: "PosMenuItems", fields: [menuItemId], references: [id])
  quantity    Int
  unitPrice   Decimal  @db.Decimal(18, 2)
  lineTotal   Decimal  @db.Decimal(18, 2)
  notes       String?
}

// ─────────────────────────────────────────────────────────────
// HR GAPS
// ─────────────────────────────────────────────────────────────
model Overtime {
  id           String   @id @default(uuid())
  hotelId      String
  userId       String
  user         User     @relation("OvertimeUser", fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime
  hours        Float
  reason       String?
  rate         Decimal  @default(0) @db.Decimal(18, 2)
  amount       Decimal  @default(0) @db.Decimal(18, 2)
  status       String   @default("Pending") // Pending, Approved, Paid
  approvedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([userId, date])
  @@index([hotelId, userId])
}

model SalaryRevision {
  id             String   @id @default(uuid())
  hotelId        String
  userId         String
  user           User     @relation("SalaryRevisions", fields: [userId], references: [id], onDelete: Cascade)
  effectiveFrom  DateTime
  previousSalary Decimal  @db.Decimal(18, 2)
  newSalary      Decimal  @db.Decimal(18, 2)
  revisionType   String   @default("Increment") // Increment, Decrement, Correction, Promotion
  reason         String?
  approvedById   String?
  remarks        String?
  createdAt      DateTime @default(now())
  @@index([userId, effectiveFrom])
  @@index([hotelId, userId])
}

model Appraisal {
  id              String   @id @default(uuid())
  hotelId         String
  userId          String
  user            User     @relation("AppraisalUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewPeriod    String
  reviewerId      String?
  performanceScore Int     @default(3)
  discipline      Int      @default(3)
  teamwork        Int      @default(3)
  punctuality     Int      @default(3)
  skills          Int      @default(3)
  overallRating   String   @default("Meets Expectations")
  comments        String?
  salaryHikePct   Float    @default(0)
  status          String   @default("Draft") // Draft, Submitted, Acknowledged
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@unique([userId, reviewPeriod])
}

// ─────────────────────────────────────────────────────────────
// 2FA
// ─────────────────────────────────────────────────────────────
model TwoFactorToken {
  id        String   @id @default(uuid())
  userId    String
  token     String
  type      String   @default("EMAIL") // EMAIL, SMS, TOTP
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  @@index([userId, used])
}

// ─────────────────────────────────────────────────────────────
// GROCERY STOCK MOVEMENT
// ─────────────────────────────────────────────────────────────
model GroceryStockMovement {
  id           String       @id @default(uuid())
  hotelId      String
  stockItemId  String
  stockItem    GroceryStock @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  movementType String       // IN, OUT, ADJUST
  quantity     Float
  reason       String?
  referenceId  String?
  performedBy  String?
  createdAt    DateTime     @default(now())
  @@index([stockItemId, createdAt])
}
// ─────────────────────────────────────────────────────────────
// IP BLACKLIST (Persistent — survives server restarts)
// ─────────────────────────────────────────────────────────────
model IpBlacklist {
  id         String   @id @default(uuid())
  ipAddress  String   @unique
  reason     String   // e.g., "10 failed login attempts"
  expiresAt  DateTime // null = permanent
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([ipAddress, expiresAt])
}

// ─────────────────────────────────────────────────────────────
// LOGIN ATTEMPTS (Per-IP failure tracking)
// ─────────────────────────────────────────────────────────────
model LoginAttempt {
  id            String   @id @default(uuid())
  ipAddress     String   @unique
  failureCount  Int      @default(0)
  lastAttemptAt DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([ipAddress, failureCount])
}

// ─────────────────────────────────────────────────────────────
// SMART ACCESS — PHASE A + B
// ─────────────────────────────────────────────────────────────

// Vendor-agnostic credential issued to a guest or staff member.
// provider field drives which LockProvider implementation is used.
model AccessCredential {
  id            String    @id @default(uuid())
  hotelId       String
  hotel         Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id])
  userId        String?   // For staff keys
  userType      String    // Guest / Staff
  accessType    String    // RFID / MobileKey / QR / PIN
  provider      String    @default("INTERNAL_QR") // ASSA_ABLOY / DORMAKABA / INTERNAL_QR
  externalRef   String?   // Encrypted vendor key ID
  accessScope   String    @default("RoomOnly") // RoomOnly / AllAccess / GymOnly / PoolOnly / ParkingOnly
  validFrom     DateTime
  validUntil    DateTime
  status        String    @default("Active") // Active / Revoked / Expired
  revokedAt     DateTime?
  revokedBy     String?   // userId who revoked
  issuedBy      String?   // userId who issued
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accessLogs    AccessLog[]

  @@index([hotelId, status])
  @@index([hotelId, reservationId])
  @@index([hotelId, validUntil])  // expiring-today query
  @@index([externalRef])
}

// Physical entry/exit events from door hardware or QR scanner
model AccessLog {
  id             String   @id @default(uuid())
  hotelId        String
  hotel          Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomId         String?
  credentialId   String
  credential     AccessCredential @relation(fields: [credentialId], references: [id])
  userType       String   // Guest / Staff
  action         String   // ENTRY / EXIT / DENIED
  source         String   // DoorLock / QRScanner / App / Webhook
  deviceId       String?
  rawPayload     Json?    // Raw vendor webhook body for debugging
  timestamp      DateTime @default(now())

  @@index([hotelId, timestamp])
  @@index([roomId, timestamp])
  @@index([credentialId, timestamp])
  @@index([hotelId, action, timestamp]) // denied entry dashboard filter
}

// Staff check-in/out via dynamic QR or geo-fence
model StaffAttendanceLog {
  id          String   @id @default(uuid())
  userId      String
  hotelId     String
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  action      String   // CHECK_IN / CHECK_OUT
  method      String   // QR / Geo / Biometric
  latitude    Float?
  longitude   Float?
  accuracy    Float?   // GPS accuracy in metres
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([hotelId, createdAt])
  @@index([hotelId, action, createdAt]) // late check-in detection
}
