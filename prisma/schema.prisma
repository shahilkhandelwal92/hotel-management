// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Represents Hotel Properties onboarded onto the system
model Hotel {
  id        String @id @default(uuid())
  name      String
  location  String
  address   String?
  phone     String?
  email     String?
  gstin     String? // Hotel GSTIN for GST billing
  state     String? // Hotel state code for CGST/SGST vs IGST
  roomCount Int    @default(0)
  status    String @default("Active") // Active, Inactive
  timezone  String @default("Asia/Kolkata") // Hotel operational timezone

  latitude       Float?   // Hotel GPS latitude for geofenced attendance
  longitude      Float?   // Hotel GPS longitude for geofenced attendance
  geofenceRadius Float?   @default(100) // Allowed check-in radius in metres

  hasInHouseRestaurant Boolean @default(true)
  zomatoLink           String?
  swiggyLink           String?
  isTaxApplicable      Boolean @default(false) // Whether tax applies (GST/VAT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  isTaxIncluded   Boolean @default(false) // Tax included in room price

  users               User[]
  events              CorporateEvent[]
  leaveTypes          LeaveType[]
  rooms               Room[]
  amenities           Amenity[]
  amenityBookings     AmenityBooking[]
  menuItems           MenuItem[]
  groceryStock        GroceryStock[]
  eventVenues         EventVenue[]
  financialRep        FinancialReport[]
  taxConfigs          TaxConfiguration[]
  roomCategories      RoomCategory[]
  reservations        Reservation[]
  guestProfiles       GuestCRMProfile[]
  shifts              Shift[]
  announcements       Announcement[]
  invoices            Invoice[]
  housekeeping        HousekeepingTask[]
  lostAndFound        LostAndFound[]
  payrollRecords      PayrollRecord[]
  nightAudits         NightAudit[]
  ratePlans           RatePlan[]
  saasSubscription    SaasSubscription?
  folios              Folio[]
  usageTracking       UsageTracking[]
  roomBlocks          RoomBlock[]
  posOrders           PosOrder[]
  accessCredentials   AccessCredential[]
  accessLogs          AccessLog[]
  staffAttendanceLogs StaffAttendanceLog[]
  userRoles           UserRole[]
  invoiceSequences    InvoiceSequence[]

  // Enterprise Framework Relations
  approvalPolicies    ApprovalPolicy[]
  approvalRequests    ApprovalRequest[]
  hotelTasks          HotelTask[]
  outboxEvents        OutboxEvent[]
  webhookEndpoints    WebhookEndpoint[]
  integrationLogs     IntegrationLog[]
  departments         Department[]
  jobRoles            JobRole[]
  reservationDeposits ReservationDeposit[]
  noShowRecords       NoShowRecord[]
  waitlists           ReservationWaitlist[]
  groupBlocks         GroupBlock[]
  cashierShifts       CashierShift[]
  arAccounts          ARAccount[]
  vendorAccounts      VendorAccount[]
  maintenanceAssets   MaintenanceAsset[]
  workOrders          WorkOrder[]
  preventiveSchedules PreventiveMaintenanceSchedule[]
  purchaseRequisitions PurchaseRequisition[]
  purchaseOrders      PurchaseOrder[]
  goodsReceiptNotes   GoodsReceiptNote[]
  inventoryStores     InventoryStore[]
  stockTransfers      StockTransfer[]
  linenItems          LinenItem[]
  minibarItems        MinibarItem[]
  minibarConsumptions MinibarConsumption[]
  channelConnections  ChannelConnection[]
  channelReservations ChannelReservation[]
  corporateLeads      CorporateLead[]
  corporateContracts  CorporateContract[]
  messageTemplates    MessageTemplate[]
  guestMessageLogs    GuestMessageLog[]
  loyaltyAccounts     LoyaltyAccount[]
  feedbackSurveys     GuestFeedbackSurvey[]
  serviceRecoveryTickets ServiceRecoveryTicket[]
  rateRestrictions    RateRestriction[]
  currencyRates       CurrencyRate[]
}

// Handles Super Admins, Hotel Admins, Staff, and Corporate Clients
model User {
  id       String @id @default(uuid())
  email    String @unique
  password String // Hashed password
  salt     String?
  name     String

  hotelId String? // Nullable because Super Admins/Corporate might not belong to a specific hotel
  hotel   Hotel?  @relation(fields: [hotelId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leaveRequests       LeaveRequest[]
  attendances         Attendance[]
  roles               UserRole[]
  auditLogs           AuditLog[]
  salaries            EmployeeSalary[]
  itrs                EmployeeITR[]
  housekeepingTasks   HousekeepingTask[] @relation("HousekeepingAssignee")
  payrollRecords      PayrollRecord[]    @relation("PayrollUser")
  shiftAssignments    ShiftAssignment[]  @relation("ShiftUser")
  announcements       Announcement[]    @relation("AnnouncementAuthor")
  overtimes           Overtime[]         @relation("OvertimeUser")
  salaryRevisions     SalaryRevision[]   @relation("SalaryRevisions")
  appraisals          Appraisal[]        @relation("AppraisalUser")
}


model Role {
  id    String @id @default(uuid())
  name  String @unique // e.g. SUPER_ADMIN, HOTEL_ADMIN, STAFF, KITCHEN, CORPORATE, ACCOUNTING
  
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique // e.g., VIEW_BOOKINGS, EDIT_FINANCIALS, MANAGE_STAFF
  description String?

  roles       RolePermission[]
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  role         Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserRole {
  id      String @id @default(uuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId  String
  role    Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  hotelId String?
  hotel   Hotel?  @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  
  @@unique([userId, roleId, hotelId])
}

// Stores dynamic subscriptions for properties
model Subscription {
  id        String   @id @default(uuid())
  hotelId   String
  planName  String // e.g., Basic, Premium, Enterprise
  amount    Decimal  @db.Decimal(18, 2)
  status    String // Active, Cancelled
  startDate DateTime
  endDate   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// CRM Hotel Leads for Enterprise Pipeline
model HotelLead {
  id             String   @id @default(uuid())
  hotelName      String
  contactPerson  String
  contactEmail   String?
  contactMobile  String?
  estimatedValue Decimal  @default(0) @db.Decimal(18, 2)
  notes          String?
  status         String   @default("Scratch") // Scratch, Qualified, Demo, Proposal, ClosedWon, ClosedLost

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Corporate Events & Conferences
model CorporateEvent {
  id            String   @id @default(uuid())
  hotelId       String
  hotel         Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name          String // e.g., Annual Tech Summit 2026
  clientName    String   @default("Corporate Client")
  corporateName String?  // Alias for clientName
  startDate     DateTime @default(now())
  endDate       DateTime @default(now())
  date          DateTime? // Alias for single-day query
  expectedCount Int?     @default(0)
  accessCode    String?  @unique
  status        String   @default("Upcoming") // Upcoming, Ongoing, Completed, Cancelled

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guests CorporateGuest[]
  orders FoodOrder[]
}

// Guests invited to or attending corporate events
model CorporateGuest {
  id          String   @id @default(uuid())
  eventId     String
  event       CorporateEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String
  email       String?
  phone       String?
  designation String?
  company     String?
  roomNumber  String? // Assigned room if staying overnight
  dietaryPref String? // Veg, Non-Veg, Vegan, Jain, etc.

  qrCode         String? // Unique QR access code for check-in
  isSeated       Boolean   @default(false)
  status         String    @default("Registered")
  attendanceTime DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requests GuestRequest[]
}

// HR – Employee Leaves
model LeaveType {
  id          String @id @default(uuid())
  hotelId     String
  hotel       Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name        String // Casual Leave, Sick Leave, Paid Leave
  maxDays     Int    @default(12)
  defaultDays Int?   @default(12)

  leaveRequests LeaveRequest[]
}

model LeaveRequest {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  startDate   DateTime
  endDate     DateTime
  reason      String
  status      String    @default("Pending") // Pending, Approved, Rejected

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// HR – Attendance Management
model Attendance {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  status    String // Present, Absent, HalfDay, Leave
  checkIn   DateTime?
  checkOut  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}

// Property Rooms
model Room {
  id          String   @id @default(uuid())
  hotelId     String
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  number      String
  type        String // Single, Double, Deluxe, Suite, Villa
  price       Decimal  @db.Decimal(18, 2)
  status      String   @default("Vacant") // Vacant, Occupied, Dirty, Cleaning, Maintenance, OutOfService
  floor       Int      @default(1)
  amenities   String?  // JSON string or comma-separated list of amenities
  lastCleaned DateTime?

  categoryId  String?
  category    RoomCategory? @relation(fields: [categoryId], references: [id])

  reservations      Reservation[]
  roomBlocks        RoomBlock[]
  housekeepingTasks HousekeepingTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([hotelId, number])
}

// Property Amenities (Spa, Pool, Gym, etc.)
model Amenity {
  id          String   @id @default(uuid())
  hotelId     String
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Decimal  @db.Decimal(18, 2)
  capacity    Int      @default(10)
  status      String   @default("Available") // Available, Maintenance, Closed

  isTaxApplicable Boolean @default(true)
  pricingType     String  @default("FIXED") // FREE, FIXED, HOURLY, PER_PERSON

  bookings AmenityBooking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model AmenityBooking {
  id            String   @id @default(uuid())
  hotelId       String
  hotel         Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  amenityId     String
  amenity       Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  guestName     String
  guestPhone    String?
  guestContact  String?
  roomNumber    String?
  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  date          DateTime?
  startTime     DateTime
  endTime       DateTime
  totalAmount   Decimal  @db.Decimal(18, 2)
  paymentStatus String   @default("Unpaid")
  status        String   @default("Confirmed") // Confirmed, Completed, Cancelled

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// In-House Restaurant & Kitchen Menu
model MenuItem {
  id          String   @id @default(uuid())
  hotelId     String
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name        String
  category    String // Starters, Main Course, Desserts, Beverages
  price       Decimal  @db.Decimal(18, 2)
  isVeg       Boolean  @default(true)
  isAvailable Boolean  @default(true)
  description String?
  spiceLevel  String?

  posOrderItems     PosOrderItem[]     @relation("PosMenuItems")
  recipeIngredients RecipeIngredient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// Kitchen Inventory & Grocery Tracking
model GroceryStock {
  id        String   @id @default(uuid())
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  item      String   @default("") // Rice, Cooking Oil, Milk, Flour
  itemName  String   @default("") // Alias for compatibility
  category  String   @default("General") // Grains, Dairy, Spices, Vegetables
  quantity  Float // in kg/liters/units
  unit      String // kg, ltr, pcs, pkt
  minAlert  Float // Trigger low stock alert if below this

  movements         GroceryStockMovement[]
  recipeIngredients RecipeIngredient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Recipe Ingredients mapping MenuItem -> GroceryStock
model RecipeIngredient {
  id          String       @id @default(uuid())
  menuItemId  String
  menuItem    MenuItem     @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  stockItemId String
  stockItem   GroceryStock @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  quantity    Float        // Quantity of ingredient required per 1 unit of menuItem
  unit        String       // kg, ltr, g, ml, pcs
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([menuItemId, stockItemId])
  @@index([menuItemId])
  @@index([stockItemId])
}

// Room Service & Event Food Orders
model FoodOrder {
  id          String   @id @default(uuid())
  eventId     String?
  event       CorporateEvent? @relation(fields: [eventId], references: [id], onDelete: Cascade)
  roomNumber  String?
  guestName   String
  items       Json // JSON Array of items { name, quantity, price }
  totalAmount Decimal  @db.Decimal(18, 2)
  status      String   @default("Pending") // Pending, Preparing, Delivered, Cancelled

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Guest Services & Dynamic Concierge Requests
model GuestRequest {
  id               String          @id @default(uuid())
  guestId          String?
  guest            CorporateGuest? @relation(fields: [guestId], references: [id], onDelete: Cascade)
  reservationId    String?
  reservation      Reservation?    @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  type             String // Extra Bed, Laundry, Housekeeping, Cab, Custom
  details          String
  status           String          @default("Pending") // Pending, InProgress, Completed, Rejected
  chargeToRoom     Boolean         @default(false)
  amount           Decimal         @default(0) @db.Decimal(18, 2) // Added by staff upon approval

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Event Banquets, Conference Halls & Lawns
model EventVenue {
  id              String   @id @default(uuid())
  hotelId         String
  hotel           Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name            String
  capacity        Int
  basePricePerDay Decimal  @db.Decimal(18, 2) // Base rental fee
  decorationPrice Decimal  @default(0) @db.Decimal(18, 2) // Fixed standard decoration charge
  foodPerPerson   Decimal  @default(0) @db.Decimal(18, 2) // Catering cost per head
  isAvailable     Boolean  @default(true)

  bookings PartyBooking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Banquets, Weddings, Birthdays & Gala Dinners
model PartyBooking {
  id            String     @id @default(uuid())
  venueId       String
  venue         EventVenue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  clientName    String
  clientPhone   String
  clientEmail   String?
  eventType     String // Wedding, Birthday, Corporate Gala, Anniversary
  eventDate     DateTime
  guestsCount   Int
  cateringOpted Boolean    @default(true)
  decorOpted    Boolean    @default(false)
  specialNotes  String?
  estimatedCost Decimal    @db.Decimal(18, 2)
  status        String     @default("Confirmed") // Pending, Confirmed, Cancelled

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Financial P&L Records
model FinancialReport {
  id            String   @id @default(uuid())
  hotelId       String
  hotel         Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  month         String // e.g., "2026-03"
  totalRevenue  Decimal  @default(0) @db.Decimal(18, 2)
  totalExpenses Decimal  @default(0) @db.Decimal(18, 2)
  netProfit     Decimal  @default(0) @db.Decimal(18, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hotelId, month])
}

// System Audit Logs
model AuditLog {
  id          String   @id @default(uuid())
  hotelId     String?
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  module      String   // "Invoice", "Payroll", "Reservation", "Room", "User"
  action      String   // "CREATE", "UPDATE", "DELETE", "APPROVE", "CHECKIN", "CHECKOUT"
  entityType  String?  // Model name for reference
  entityId    String?  // ID of the affected record
  oldValue    Json?    // Snapshot before change
  newValue    Json?    // Snapshot after change
  details     String?  // Free-text notes
  ipAddress   String?
  userAgent   String?  // For fraud detection & debugging

  createdAt   DateTime @default(now())

  @@index([hotelId, createdAt])
  @@index([userId, createdAt])
  @@index([entityId])
}

// Accounting & Tax Configuration
model TaxConfiguration {
  id                    String   @id @default(uuid())
  hotelId               String
  hotel                 Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  financialYear         String   // e.g., "2025-2026"
  taxType               String   @default("GST") // e.g., GST, VAT
  taxRegistrationNumber String?  // e.g., GSTIN
  companyState          String?  // To compute CGST+SGST vs IGST
  
  // Tax percents
  roomTaxPct            Float    @default(0)
  restaurantTaxPct      Float    @default(0)
  barTaxPct             Float    @default(0)
  amenityTaxPct         Float    @default(0)
  tdsPct                Float    @default(0)

  // Is tax applicable overall for this year?
  isTaxApplicable       Boolean  @default(true) 

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([hotelId, financialYear]) // Only one config per hotel per year
}

// Internal HR & Owner Resources
model EmployeeSalary {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month          String   // e.g., "2026-03"
  basicSalary    Decimal  @default(0) @db.Decimal(18, 2)
  allowances     Decimal  @default(0) @db.Decimal(18, 2)
  deductions     Decimal  @default(0) @db.Decimal(18, 2)
  netSalary      Decimal  @default(0) @db.Decimal(18, 2)
  paymentStatus  String   @default("UNPAID") // UNPAID, PAID
  paymentDate    DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, month])
}

model EmployeeITR {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  financialYear  String   // e.g., "2025-2026"
  documentUrl    String?  // Link to ITR PDF/doc
  status         String   @default("PENDING") // PENDING, FILED
  filedDate      DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, financialYear])
}

// ─────────────────────────────────────────────────────────────
// PMS – ROOM CATEGORIES
// ─────────────────────────────────────────────────────────────
model RoomCategory {
  id           String @id @default(uuid())
  name         String // e.g., Deluxe, Suite, Standard
  description  String?
  basePrice    Decimal  @default(0) @db.Decimal(18, 2)
  maxOccupancy Int    @default(2)
  hotelId      String
  hotel        Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  rooms        Room[]
}

// ─────────────────────────────────────────────────────────────
// PMS – RESERVATIONS
// ─────────────────────────────────────────────────────────────
model Reservation {
  id              String   @id @default(uuid())
  bookingRef      String   @unique @default(uuid()) // Human-readable ref
  hotelId         String
  hotel           Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomId          String?
  room            Room?    @relation(fields: [roomId], references: [id])

  // Guest info (may or may not be in GuestCRMProfile)
  guestName       String
  guestEmail      String?
  guestPhone      String
  guestAddress    String?
  guestCity       String?
  guestState      String?  // Used for CGST/SGST vs IGST determination
  guestGstin      String?  // For B2B GST
  idType          String?  // Aadhaar, Passport, DL
  idNumber        String?

  // Booking details
  bookingType     String   @default("Individual") // Individual, Group, Corporate, Walkin
  ratePlan        String   @default("Standard") // Standard, Corporate, OTA
  ratePlanId      String?  // FK to RatePlan table
  adults          Int      @default(1)
  children        Int      @default(0)

  checkIn         DateTime
  checkOut        DateTime
  actualCheckIn   DateTime?
  actualCheckOut  DateTime?

  baseAmount      Decimal  @default(0) @db.Decimal(18, 2)
  taxAmount       Decimal  @default(0) @db.Decimal(18, 2)
  totalAmount     Decimal  @default(0) @db.Decimal(18, 2)
  advanceDeposit  Decimal  @default(0) @db.Decimal(18, 2)
  balanceDue      Decimal  @default(0) @db.Decimal(18, 2)

  includesBreakfast Boolean @default(false)
  includesDinner    Boolean @default(false)
  specialRequests   String?

  status          String   @default("Confirmed") // Confirmed, CheckedIn, CheckedOut, Cancelled, NoShow
  deletedAt       DateTime? // Soft delete

  // Self check-in / check-out timestamps (guest-initiated)
  selfCheckInAt   DateTime?
  selfCheckOutAt  DateTime?

  // Relations
  guestProfileId  String?
  guestProfile    GuestCRMProfile? @relation(fields: [guestProfileId], references: [id])
  invoices        Invoice[]
  folios          Folio[]
  accessCredentials AccessCredential[]
  guestRequests     GuestRequest[]
  amenityBookings   AmenityBooking[]
  posOrders         PosOrder[]
  deposits          ReservationDeposit[]
  noShowRecord      NoShowRecord?
  channelReservation ChannelReservation?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([hotelId, checkIn, status])
  @@index([hotelId, status])
  @@index([hotelId, checkOut])
  @@index([roomId, checkIn])
  @@index([deletedAt])
}

// ─────────────────────────────────────────────────────────────
// HOUSEKEEPING
// ─────────────────────────────────────────────────────────────
model HousekeepingTask {
  id            String   @id @default(uuid())
  hotelId       String
  hotel         Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomId        String?
  room          Room?    @relation(fields: [roomId], references: [id])
  roomNumber    String
  taskType      String   @default("Clean") // Clean, Inspect, Turndown, Maintenance
  priority      String   @default("Normal") // Low, Normal, High, Urgent
  assignedToId  String?
  assignedTo    User?    @relation("HousekeepingAssignee", fields: [assignedToId], references: [id])
  checklist     Json? // Array of { item: string, done: boolean }
  notes         String?
  status        String   @default("Pending") // Pending, InProgress, Completed, Skipped
  completedAt   DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model LostAndFound {
  id            String   @id @default(uuid())
  hotelId       String
  hotel         Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  itemName      String
  description   String?
  foundLocation String?
  foundDate     DateTime @default(now())
  foundByName   String?
  guestName     String?
  guestContact  String?
  status        String   @default("Found") // Found, Claimed, Disposed
  estimatedValue Decimal @default(0) @db.Decimal(18, 2)
  resolvedAt    DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// BILLING & GST ENGINE
// ─────────────────────────────────────────────────────────────
model Invoice {
  id              String   @id @default(uuid())
  invoiceNumber   String   @unique
  invoiceType     String   @default("TAX") // TAX, PROFORMA, CREDIT_NOTE, DEBIT_NOTE, ADVANCE, REFUND
  hotelId         String
  hotel           Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  reservationId   String?
  reservation     Reservation? @relation(fields: [reservationId], references: [id])

  // Billing party
  billedToName    String
  billedToEmail   String?
  billedToPhone   String?
  billedToAddress String?
  billedToGstin   String?
  billedToState   String?  // Used for CGST/SGST vs IGST

  // GST breakdown
  subTotal        Decimal  @default(0) @db.Decimal(18, 2)
  cgst            Decimal  @default(0) @db.Decimal(18, 2) // 50% of GST for intra-state
  sgst            Decimal  @default(0) @db.Decimal(18, 2) // 50% of GST for intra-state
  igst            Decimal  @default(0) @db.Decimal(18, 2) // 100% of GST for inter-state
  totalTax        Decimal  @default(0) @db.Decimal(18, 2)
  grandTotal      Decimal  @default(0) @db.Decimal(18, 2)
  roundOff        Decimal  @default(0) @db.Decimal(18, 2)

  // GST Advanced Fields
  invoiceFormat   String   @default("B2C") // B2B, B2C
  isReverseCharge Boolean  @default(false) // RCM applicable
  isExempt        Boolean  @default(false) // GST exempt (hospital/edu)

  // Credit Note / Debit Note linkage (self-relation)
  creditNoteForId String?  // Points to original invoice
  creditNoteFor   Invoice? @relation("CreditNoteRelation", fields: [creditNoteForId], references: [id])
  creditNotes     Invoice[] @relation("CreditNoteRelation")

  status          String   @default("Unpaid") // Unpaid, Partial, Paid, Cancelled
  notes           String?
  dueDate         DateTime?
  deletedAt       DateTime?

  items           InvoiceItem[]
  payments        Payment[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([hotelId, createdAt])
  @@index([hotelId, createdAt, status])  // GST report: date + status filter
  @@index([hotelId, status])             // billing status dashboard
  @@index([status, dueDate])
  @@index([deletedAt])
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  itemType    String  // Room, Food, Amenity, Event, Service, Other
  description String
  hsnSac      String? // HSN for goods, SAC for services
  quantity    Float   @default(1)
  unitPrice   Decimal @db.Decimal(18, 2)
  discount    Decimal @default(0) @db.Decimal(18, 2)
  taxRate     Float   @default(0)
  taxAmount   Decimal @default(0) @db.Decimal(18, 2)
  // Stored GST breakup (avoid recalculation for audits)
  cgstAmount  Decimal? @default(0) @db.Decimal(18, 2)
  sgstAmount  Decimal? @default(0) @db.Decimal(18, 2)
  igstAmount  Decimal? @default(0) @db.Decimal(18, 2)
  lineTotal   Decimal @db.Decimal(18, 2)
}

model Payment {
  id                    String   @id @default(uuid())
  hotelId               String?  // For index queries
  invoiceId             String
  invoice               Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount                Decimal  @db.Decimal(18, 2)
  paymentMode           String   // Cash, Card, UPI, Wallet, Cheque, BankTransfer
  paymentGateway        String?  // Razorpay, PhonePe, Paytm, Stripe, Manual
  transactionRef        String?  // Internal reference
  gatewayTransactionId  String?  // Gateway's transaction ID (for reconciliation)
  reconciliationStatus  String   @default("Pending") // Pending, Reconciled, Failed, Disputed
  settledAt             DateTime?
  notes                 String?
  paidAt                DateTime @default(now())

  createdAt     DateTime @default(now())

  @@index([hotelId, createdAt])
}

// Atomic Sequence Generator for Invoices (Race-condition safe)
model InvoiceSequence {
  id            String   @id @default(uuid())
  hotelId       String
  hotel         Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  financialYear String
  prefix        String   @default("INV")
  nextNumber    Int      @default(1)
  updatedAt     DateTime @updatedAt

  @@unique([hotelId, financialYear, prefix])
  @@index([hotelId, financialYear])
}

// ─────────────────────────────────────────────────────────────
// PAYROLL MODULE (greytHR-like)
// ─────────────────────────────────────────────────────────────
model PayrollRecord {
  id              String   @id @default(uuid())
  hotelId         String
  hotel           Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation("PayrollUser", fields: [userId], references: [id], onDelete: Cascade)
  month           String   // e.g., "2026-03"

  // Earnings
  basicSalary     Decimal  @default(0) @db.Decimal(18, 2)
  hra             Decimal  @default(0) @db.Decimal(18, 2)
  conveyance      Decimal  @default(0) @db.Decimal(18, 2)
  medicalAllowance Decimal @default(0) @db.Decimal(18, 2)
  otherAllowances Decimal  @default(0) @db.Decimal(18, 2)
  overtime        Decimal  @default(0) @db.Decimal(18, 2)
  bonus           Decimal  @default(0) @db.Decimal(18, 2)
  incentives      Decimal  @default(0) @db.Decimal(18, 2)
  grossSalary     Decimal  @default(0) @db.Decimal(18, 2)

  // Statutory deductions
  pf              Decimal  @default(0) @db.Decimal(18, 2) // Provident Fund (12% of basic)
  esi             Decimal  @default(0) @db.Decimal(18, 2) // ESI (0.75% if gross < 21000)
  pt              Decimal  @default(0) @db.Decimal(18, 2) // Professional Tax (state slab)
  tds             Decimal  @default(0) @db.Decimal(18, 2) // Income Tax deduction
  otherDeductions Decimal  @default(0) @db.Decimal(18, 2)
  totalDeductions Decimal  @default(0) @db.Decimal(18, 2)

  netSalary       Decimal  @default(0) @db.Decimal(18, 2)
  workingDays     Int      @default(26)
  lopDays         Int      @default(0) // Loss of Pay days

  paymentStatus   String   @default("Draft") // Draft, Approved, Paid
  paymentDate     DateTime?
  approvedById    String?
  remarks         String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, month])
}

// ─────────────────────────────────────────────────────────────
// CRM – GUEST MANAGEMENT
// ─────────────────────────────────────────────────────────────
model GuestCRMProfile {
  id              String   @id @default(uuid())
  hotelId         String
  hotel           Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name            String
  email           String?
  phone           String
  address         String?
  city            String?
  state           String?
  country         String   @default("India")
  gstin           String?
  dateOfBirth     DateTime?
  anniversary     DateTime?
  nationality     String?
  idType          String?
  idNumber        String?

  segment         String   @default("Leisure") // Leisure, Corporate, VIP, Group
  preferences     Json? // Room type, floor, dietary, etc.
  loyaltyPoints   Int      @default(0)
  totalStays      Int      @default(0)
  totalSpend      Decimal  @default(0) @db.Decimal(18, 2)

  reservations    Reservation[]
  loyaltyLedger   LoyaltyTransaction[]
  complaints      GuestComplaint[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model LoyaltyTransaction {
  id              String   @id @default(uuid())
  guestProfileId  String
  guestProfile    GuestCRMProfile @relation(fields: [guestProfileId], references: [id], onDelete: Cascade)
  points          Int      // Positive = earned, Negative = redeemed
  type            String   // Earn, Redeem, Adjust, Expire
  reason          String?
  referenceId     String?  // Invoice/booking ref

  createdAt       DateTime @default(now())
}

model GuestComplaint {
  id              String   @id @default(uuid())
  guestProfileId  String?
  guestProfile    GuestCRMProfile? @relation(fields: [guestProfileId], references: [id])
  guestName       String
  guestContact    String?
  hotelId         String?
  department      String?  // Housekeeping, F&B, Front Desk, Maintenance
  subject         String
  description     String?
  priority        String   @default("Normal") // Low, Normal, High, Urgent
  status          String   @default("Open") // Open, InProgress, Resolved, Closed
  assignedToId    String?
  resolution      String?
  resolvedAt      DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// HR – SHIFT MANAGEMENT
// ─────────────────────────────────────────────────────────────
model Shift {
  id          String   @id @default(uuid())
  hotelId     String
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name        String   // e.g., "Morning", "Evening", "Night"
  startTime   String   // "06:00"
  endTime     String   // "14:00"
  color       String   @default("#4f46e5")

  assignments ShiftAssignment[]
}

model ShiftAssignment {
  id        String   @id @default(uuid())
  shiftId   String
  shift     Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("ShiftUser", fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime // The specific date for this assignment

  @@unique([userId, date])
}

// ─────────────────────────────────────────────────────────────
// ANNOUNCEMENTS
// ─────────────────────────────────────────────────────────────
model Announcement {
  id          String   @id @default(uuid())
  hotelId     String?
  hotel       Hotel?   @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  title       String
  body        String
  audience    String   @default("All") // All, Staff, Admin, Department
  department  String?
  priority    String   @default("Normal") // Normal, Important, Urgent
  publishedAt DateTime @default(now())
  expiresAt   DateTime?
  createdById String?
  createdBy   User?    @relation("AnnouncementAuthor", fields: [createdById], references: [id])

  createdAt   DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────
// NIGHT AUDIT SYSTEM (Hotel Finance Critical)
// ─────────────────────────────────────────────────────────────
model NightAudit {
  id              String   @id @default(uuid())
  hotelId         String
  hotel           Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  auditDate       DateTime
  closedById      String?  // User who closed the day
  closedAt        DateTime?
  status          String   @default("Open") // Open, Closed, Reopened
  isDayClosed     Boolean  @default(false)   // Flag to lock edits for that day

  // Auto-posted revenue summary
  roomRevenue     Decimal  @default(0) @db.Decimal(18, 2)
  fbRevenue       Decimal  @default(0) @db.Decimal(18, 2)
  amenityRevenue  Decimal  @default(0) @db.Decimal(18, 2)
  eventRevenue    Decimal  @default(0) @db.Decimal(18, 2)
  otherRevenue    Decimal  @default(0) @db.Decimal(18, 2)
  totalRevenue    Decimal  @default(0) @db.Decimal(18, 2)
  totalDeductions Decimal  @default(0) @db.Decimal(18, 2) // Refunds, discounts

  // Occupancy snapshot
  occupiedRooms   Int      @default(0)
  totalRooms      Int      @default(0)
  occupancyPct    Float    @default(0)

  notes           String?
  reopenedById    String?
  reopenedAt      DateTime?
  reopenReason    String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([hotelId, auditDate])
  @@index([hotelId, auditDate])
}

// ─────────────────────────────────────────────────────────────
// FOLIO SYSTEM (Running Guest Ledger)
// ─────────────────────────────────────────────────────────────
model Folio {
  id              String   @id @default(uuid())
  hotelId         String
  hotel           Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  reservationId   String
  reservation     Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  folioType       String   @default("Room") // Room, Company, Split, Miscellaneous
  balance         Decimal  @default(0) @db.Decimal(18, 2) // Running balance (positive = guest owes)
  status          String   @default("Open") // Open, Closed, Transferred

  transactions    FolioTransaction[]
  folioWindows    FolioWindow[]
  routingRules    FolioRoutingRule[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([reservationId])
  @@index([hotelId])
}

model FolioTransaction {
  id              String   @id @default(uuid())
  folioId         String
  folio           Folio    @relation(fields: [folioId], references: [id], onDelete: Cascade)
  type            String   // Charge, Payment, Refund, Adjustment, Transfer, Opening
  description     String
  amount          Decimal  @db.Decimal(18, 2) // Positive = charge/debit, Negative = credit/payment
  referenceId     String?  // invoiceId, paymentId, etc.
  paymentMode     String?  // Cash, Card, UPI, BankTransfer, Online
  nightAuditId    String?  // Auto-posted by night audit
  postedById      String?  // Staff who posted
  postedAt        DateTime @default(now())

  createdAt       DateTime @default(now())

  @@index([folioId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// ROOM BLOCK (Overbooking Prevention)
// ─────────────────────────────────────────────────────────────
model RoomBlock {
  id              String   @id @default(uuid())
  hotelId         String
  hotel           Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomId          String
  room            Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  date            DateTime
  reservationId   String?  // Which reservation holds this block

  @@unique([roomId, date])
  @@index([roomId, date])
}

// ─────────────────────────────────────────────────────────────
// RATE PLAN ENGINE
// ─────────────────────────────────────────────────────────────
model RatePlan {
  id                  String   @id @default(uuid())
  hotelId             String
  hotel               Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name                String   // e.g., "Peak Season Corporate"
  code                String   // PEAK, CORP, WKD, OTA
  description         String?
  baseMultiplier      Float    @default(1.0) // Multiplied on base room price
  cancellationHours   Int      @default(24)  // Hours before check-in for free cancel
  refundPolicy        String   @default("FullRefund48h") // FullRefund48h, NoRefund, PartialRefund
  mealPlan            String   @default("RO") // RO (Room Only), CP, MAP, AP
  isActive            Boolean  @default(true)

  rules               RatePlanRule[]
  seasonalRates       SeasonalRate[]

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([hotelId, code])
}

model RatePlanRule {
  id          String   @id @default(uuid())
  ratePlanId  String
  ratePlan    RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)
  ruleType    String   // Weekend, Weekday, MinStay, MaxStay, EarlyBird, LongStay
  multiplier  Float    @default(1.0) // Applied on top of base multiplier
  value       String?  // e.g. "2" for MinStay 2 nights
}

model SeasonalRate {
  id          String   @id @default(uuid())
  ratePlanId  String
  ratePlan    RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)
  name        String   // "Diwali Peak", "Summer Off-Season"
  startDate   DateTime
  endDate     DateTime
  multiplier  Float    @default(1.0)
  isActive    Boolean  @default(true)
}

// ─────────────────────────────────────────────────────────────
// SAAS PLATFORM LAYER
// ─────────────────────────────────────────────────────────────

// Normalized features table (avoids typo-based bugs)
model Feature {
  id          String   @id @default(uuid())
  code        String   @unique // "PMS", "POS", "PAYROLL", "CRM", "EVENTS", "ANALYTICS"
  name        String             // Display name
  description String?

  planFeatures SaasPlanFeature[]
}

model SaasPlan {
  id            String   @id @default(uuid())
  name          String   @unique  // "starter", "growth", "enterprise"
  displayName   String            // "Starter", "Growth", "Enterprise"
  priceMonthly  Decimal  @default(0) @db.Decimal(18, 2)
  priceAnnual   Decimal  @default(0) @db.Decimal(18, 2)
  maxHotels     Int      @default(1)
  maxUsers      Int      @default(10)
  maxRooms      Int      @default(50)
  isActive      Boolean  @default(true)

  features      SaasPlanFeature[]
  subscriptions SaasSubscription[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SaasPlanFeature {
  id        String   @id @default(uuid())
  planId    String
  plan      SaasPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  featureId String
  feature   Feature  @relation(fields: [featureId], references: [id], onDelete: Cascade)
  enabled   Boolean  @default(true)
  limitValue Int?    // Optional: e.g., max POS terminals allowed

  @@unique([planId, featureId])
}

model SaasSubscription {
  id                   String   @id @default(uuid())
  hotelId              String   @unique
  hotel                Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  planId               String
  plan                 SaasPlan @relation(fields: [planId], references: [id])
  status               String   @default("Trial") // Trial, Active, Suspended, Cancelled, PastDue
  billingCycle         String   @default("Monthly") // Monthly, Annual
  trialEndsAt          DateTime?
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean  @default(false)
  cancelledAt          DateTime?

  saasInvoices         SaasInvoice[]

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([status])
}

model SaasInvoice {
  id              String           @id @default(uuid())
  subscriptionId  String
  subscription    SaasSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  invoiceNumber   String           @unique
  amount          Decimal          @db.Decimal(18, 2)
  currency        String           @default("INR")
  status          String           @default("Unpaid") // Unpaid, Paid, Failed, Waived
  billingPeriod   String           // "2026-03" (month or period label)
  dueDate         DateTime
  paidAt          DateTime?
  notes           String?

  payments        SaasPayment[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SaasPayment {
  id              String      @id @default(uuid())
  saasInvoiceId   String
  saasInvoice     SaasInvoice @relation(fields: [saasInvoiceId], references: [id], onDelete: Cascade)
  amount          Decimal     @db.Decimal(18, 2)
  paymentMethod   String      // Razorpay, Stripe, BankTransfer, Manual
  transactionId   String?     // Gateway transaction ID
  status          String      @default("Success") // Success, Failed, Refunded
  paidAt          DateTime?

  createdAt       DateTime    @default(now())
}

// ─────────────────────────────────────────────────────────────
// USAGE TRACKING (Plan Enforcement)
// ─────────────────────────────────────────────────────────────
model UsageTracking {
  id        String   @id @default(uuid())
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  metric    String   // "rooms", "users", "reservations", "storage_mb", "invoices"
  value     Int      @default(0)
  period    String   // "2026-03" (month-year)

  updatedAt DateTime @updatedAt

  @@unique([hotelId, metric, period])
  @@index([hotelId, metric])
}

// ─────────────────────────────────────────────────────────────
// POS MODULE – ORDERS
// ─────────────────────────────────────────────────────────────
model PosOrder {
  id            String   @id @default(uuid())
  hotelId       String
  hotel         Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  tableNumber   String?
  orderSource   String   @default("Walkin") // Walkin, InHouse, Event, RoomService
  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  guestName     String?
  kotPrinted    Boolean  @default(false)
  subtotal      Decimal  @default(0) @db.Decimal(18, 2)
  gstAmount     Decimal  @default(0) @db.Decimal(18, 2)
  grandTotal    Decimal  @default(0) @db.Decimal(18, 2)
  discount      Decimal  @default(0) @db.Decimal(18, 2)
  paymentStatus String   @default("Unpaid") // Unpaid, Paid, Folio
  paymentMode   String?
  status        String   @default("Pending") // Pending, Preparing, Ready, Served, Completed, Cancelled
  completedAt   DateTime?
  items         PosOrderItem[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([hotelId, status])
  @@index([hotelId, createdAt])
}

model PosOrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       PosOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId  String
  menuItem    MenuItem @relation(name: "PosMenuItems", fields: [menuItemId], references: [id])
  quantity    Int
  unitPrice   Decimal  @db.Decimal(18, 2)
  lineTotal   Decimal  @db.Decimal(18, 2)
  notes       String?
}

// ─────────────────────────────────────────────────────────────
// HR GAPS
// ─────────────────────────────────────────────────────────────
model Overtime {
  id           String   @id @default(uuid())
  hotelId      String
  userId       String
  user         User     @relation("OvertimeUser", fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime
  hours        Float
  reason       String?
  rate         Decimal  @default(0) @db.Decimal(18, 2)
  amount       Decimal  @default(0) @db.Decimal(18, 2)
  status       String   @default("Pending") // Pending, Approved, Paid
  approvedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([userId, date])
  @@index([hotelId, userId])
}

model SalaryRevision {
  id             String   @id @default(uuid())
  hotelId        String
  userId         String
  user           User     @relation("SalaryRevisions", fields: [userId], references: [id], onDelete: Cascade)
  effectiveFrom  DateTime
  previousSalary Decimal  @db.Decimal(18, 2)
  newSalary      Decimal  @db.Decimal(18, 2)
  revisionType   String   @default("Increment") // Increment, Decrement, Correction, Promotion
  reason         String?
  approvedById   String?
  remarks        String?
  createdAt      DateTime @default(now())
  @@index([userId, effectiveFrom])
  @@index([hotelId, userId])
}

model Appraisal {
  id              String   @id @default(uuid())
  hotelId         String
  userId          String
  user            User     @relation("AppraisalUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewPeriod    String
  reviewerId      String?
  performanceScore Int     @default(3)
  discipline      Int      @default(3)
  teamwork        Int      @default(3)
  punctuality     Int      @default(3)
  skills          Int      @default(3)
  overallRating   String   @default("Meets Expectations")
  comments        String?
  salaryHikePct   Float    @default(0)
  status          String   @default("Draft") // Draft, Submitted, Acknowledged
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@unique([userId, reviewPeriod])
}

// ─────────────────────────────────────────────────────────────
// 2FA
// ─────────────────────────────────────────────────────────────
model TwoFactorToken {
  id        String   @id @default(uuid())
  userId    String
  token     String
  type      String   @default("EMAIL") // EMAIL, SMS, TOTP
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  @@index([userId, used])
}

// ─────────────────────────────────────────────────────────────
// GROCERY STOCK MOVEMENT
// ─────────────────────────────────────────────────────────────
model GroceryStockMovement {
  id           String       @id @default(uuid())
  hotelId      String
  stockItemId  String
  stockItem    GroceryStock @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  movementType String       // IN, OUT, ADJUST
  quantity     Float
  reason       String?
  referenceId  String?
  performedBy  String?
  createdAt    DateTime     @default(now())
  @@index([stockItemId, createdAt])
}
// ─────────────────────────────────────────────────────────────
// IP BLACKLIST (Persistent — survives server restarts)
// ─────────────────────────────────────────────────────────────
model IpBlacklist {
  id         String   @id @default(uuid())
  ipAddress  String   @unique
  reason     String   // e.g., "10 failed login attempts"
  expiresAt  DateTime // null = permanent
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([ipAddress, expiresAt])
}

// ─────────────────────────────────────────────────────────────
// LOGIN ATTEMPTS (Per-IP failure tracking)
// ─────────────────────────────────────────────────────────────
model LoginAttempt {
  id            String   @id @default(uuid())
  ipAddress     String   @unique
  failureCount  Int      @default(0)
  lastAttemptAt DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([ipAddress, failureCount])
}

// ─────────────────────────────────────────────────────────────
// SMART ACCESS — PHASE A + B
// ─────────────────────────────────────────────────────────────

// Vendor-agnostic credential issued to a guest or staff member.
// provider field drives which LockProvider implementation is used.
model AccessCredential {
  id            String    @id @default(uuid())
  hotelId       String
  hotel         Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id])
  userId        String?   // For staff keys
  userType      String    // Guest / Staff
  accessType    String    // RFID / MobileKey / QR / PIN
  provider      String    @default("INTERNAL_QR") // ASSA_ABLOY / DORMAKABA / INTERNAL_QR
  externalRef   String?   // Encrypted vendor key ID
  accessScope   String    @default("RoomOnly") // RoomOnly / AllAccess / GymOnly / PoolOnly / ParkingOnly
  validFrom     DateTime
  validUntil    DateTime
  status        String    @default("Active") // Active / Revoked / Expired
  revokedAt     DateTime?
  revokedBy     String?   // userId who revoked
  issuedBy      String?   // userId who issued
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accessLogs    AccessLog[]

  @@index([hotelId, status])
  @@index([hotelId, reservationId])
  @@index([hotelId, validUntil])  // expiring-today query
  @@index([externalRef])
}

// Physical entry/exit events from door hardware or QR scanner
model AccessLog {
  id             String   @id @default(uuid())
  hotelId        String
  hotel          Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomId         String?
  credentialId   String
  credential     AccessCredential @relation(fields: [credentialId], references: [id])
  userType       String   // Guest / Staff
  action         String   // ENTRY / EXIT / DENIED
  source         String   // DoorLock / QRScanner / App / Webhook
  deviceId       String?
  rawPayload     Json?    // Raw vendor webhook body for debugging
  timestamp      DateTime @default(now())

  @@index([hotelId, timestamp])
  @@index([roomId, timestamp])
  @@index([credentialId, timestamp])
  @@index([hotelId, action, timestamp]) // denied entry dashboard filter
}

// Staff check-in/out via dynamic QR or geo-fence
model StaffAttendanceLog {
  id          String   @id @default(uuid())
  userId      String
  hotelId     String
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  action      String   // CHECK_IN / CHECK_OUT
  method      String   // QR / Geo / Biometric
  latitude    Float?
  longitude   Float?
  accuracy    Float?   // GPS accuracy in metres
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([hotelId, createdAt])
  @@index([hotelId, action, createdAt]) // late check-in detection
}

// ─────────────────────────────────────────────────────────────
// 1. APPROVAL ENGINE
// ─────────────────────────────────────────────────────────────
model ApprovalPolicy {
  id               String   @id @default(uuid())
  hotelId          String
  hotel            Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  actionType       String   // DISCOUNT, REFUND, RATE_OVERRIDE, INVOICE_CANCEL, PO_APPROVE, STOCK_ADJUST, CASHIER_VARIANCE, CREDIT_LIMIT, COMP_ROOM, WRITE_OFF
  minAmount        Decimal? @db.Decimal(18, 2)
  maxAmount        Decimal? @db.Decimal(18, 2)
  requiredRole     String   // Role required to approve (e.g. MANAGER, HOTEL_ADMIN)
  approvalLevels   Int      @default(1)
  autoApproveBelow Decimal? @db.Decimal(18, 2)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  requests         ApprovalRequest[]

  @@index([hotelId, actionType, isActive])
}

model ApprovalRequest {
  id              String   @id @default(uuid())
  hotelId         String
  hotel           Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  policyId        String?
  policy          ApprovalPolicy? @relation(fields: [policyId], references: [id], onDelete: SetNull)
  requesterId     String
  actionType      String   // DISCOUNT, REFUND, RATE_OVERRIDE, etc.
  entityType      String   // Reservation, Folio, PosOrder, PurchaseOrder, CashierShift
  entityId        String
  requestedAmount Decimal? @db.Decimal(18, 2)
  reason          String
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
  currentStep     Int      @default(1)
  totalSteps      Int      @default(1)
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  steps           ApprovalStep[]
  actions         ApprovalAction[]

  @@index([hotelId, status])
  @@index([hotelId, entityType, entityId])
}

model ApprovalStep {
  id          String   @id @default(uuid())
  requestId   String
  request     ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  stepNumber  Int
  targetRole  String
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewedBy  String?
  reviewedAt  DateTime?
  comments    String?
  createdAt   DateTime @default(now())

  @@index([requestId, stepNumber])
}

model ApprovalAction {
  id          String   @id @default(uuid())
  requestId   String
  request     ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actorId     String
  action      String   // SUBMITTED, APPROVED, REJECTED, CANCELLED, DELEGATED
  comments    String?
  createdAt   DateTime @default(now())

  @@index([requestId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// 2. TASK & TRACE ENGINE
// ─────────────────────────────────────────────────────────────
model HotelTask {
  id            String   @id @default(uuid())
  hotelId       String
  hotel         Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  category      String   // GUEST_REQUEST, MAINTENANCE, VIP_ARRIVAL, AIRPORT_PICKUP, WAKE_UP_CALL, LATE_CHECKOUT, INSPECTION, AR_COLLECTION, GENERAL
  priority      String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  title         String
  description   String?
  status        String   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, CANCELLED, ESCALATED
  dueDate       DateTime?
  roomId        String?
  guestId       String?
  reservationId String?
  assignedTo    String?  // userId
  createdBy     String   // userId
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  comments      TaskComment[]
  statusHistory TaskStatusHistory[]

  @@index([hotelId, status, priority])
  @@index([hotelId, category])
  @@index([hotelId, assignedTo])
  @@index([hotelId, dueDate])
}

model TaskComment {
  id        String    @id @default(uuid())
  taskId    String
  task      HotelTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  comment   String
  createdAt DateTime  @default(now())

  @@index([taskId, createdAt])
}

model TaskStatusHistory {
  id         String    @id @default(uuid())
  taskId     String
  task       HotelTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fromStatus String
  toStatus   String
  changedBy  String
  reason     String?
  createdAt  DateTime  @default(now())

  @@index([taskId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// 3. OUTBOX & INTEGRATION PLATFORM
// ─────────────────────────────────────────────────────────────
model OutboxEvent {
  id            String   @id @default(uuid())
  hotelId       String
  hotel         Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  eventType     String   // RESERVATION_CREATED, CHECKIN_COMPLETED, PAYMENT_PROCESSED, INVOICE_GENERATED, FOLIO_CHARGED, GUEST_MESSAGE_DISPATCH, OTA_AVAILABILITY_SYNC, WEBHOOK_EVENT
  aggregateType String   // Reservation, Folio, Payment, Invoice, GuestMessage, RoomBlock
  aggregateId   String
  payload       Json
  status        String   @default("PENDING") // PENDING, PROCESSING, PUBLISHED, FAILED, DEAD_LETTER
  retryCount    Int      @default(0)
  maxRetries    Int      @default(5)
  nextRetryAt   DateTime?
  errorMessage  String?
  publishedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([hotelId, status, nextRetryAt])
  @@index([aggregateType, aggregateId])
}

model WebhookEndpoint {
  id          String   @id @default(uuid())
  hotelId     String
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  url         String
  secret      String   // HMAC signing secret
  events      Json     // Array of subscribed event strings
  isActive    Boolean  @default(true)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deliveries  WebhookDeliveryAttempt[]

  @@index([hotelId, isActive])
}

model WebhookDeliveryAttempt {
  id           String          @id @default(uuid())
  endpointId   String
  endpoint     WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  eventId      String
  statusCode   Int?
  responseBody String?
  durationMs   Int?
  success      Boolean         @default(false)
  errorMessage String?
  createdAt    DateTime        @default(now())

  @@index([endpointId, createdAt])
}

model IntegrationLog {
  id             String   @id @default(uuid())
  hotelId        String
  hotel          Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  provider       String   // BOOKING_COM, EXPEDIA, AGODA, AIRBNB, MAKEMYTRIP, RAZORPAY, STRIPE, TWILIO, GUPSHUP, SENDGRID
  direction      String   // INBOUND, OUTBOUND
  action         String   // SYNC_AVAILABILITY, SYNC_RATE, IMPORT_RESERVATION, SEND_MESSAGE, PROCESS_PAYMENT
  status         String   // SUCCESS, FAILED, RETRYING
  requestPayload Json?
  responsePayload Json?
  errorMessage   String?
  createdAt      DateTime @default(now())

  @@index([hotelId, provider, createdAt])
}

// ─────────────────────────────────────────────────────────────
// 4. HIERARCHICAL RBAC & DEPARTMENTS
// ─────────────────────────────────────────────────────────────
model Department {
  id          String   @id @default(uuid())
  hotelId     String
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name        String   // Front Office, Housekeeping, Food & Beverage, Finance, Engineering, Sales & Marketing, Human Resources, Security, Executive
  code        String   // FO, HK, FNB, FIN, ENG, SM, HR, SEC, EXEC
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  jobRoles    JobRole[]

  @@unique([hotelId, code])
  @@index([hotelId])
}

model JobRole {
  id            String     @id @default(uuid())
  hotelId       String
  hotel         Hotel      @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  departmentId  String
  department    Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  title         String   // General Manager, Front Desk Agent, Duty Manager, Executive Housekeeper, Chef, F&B Captain, Financial Controller, Cashier, AR Accountant, Chief Engineer
  code          String
  baseRole      String     @default("STAFF") // Maps to existing 13 roles
  approvalLimit Decimal    @default(0) @db.Decimal(18, 2)
  description   String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  userAssignments UserRoleAssignment[]

  @@unique([hotelId, code])
  @@index([hotelId, departmentId])
}

model UserRoleAssignment {
  id          String   @id @default(uuid())
  userId      String
  jobRoleId   String
  jobRole     JobRole  @relation(fields: [jobRoleId], references: [id], onDelete: Cascade)
  hotelId     String
  assignedAt  DateTime @default(now())

  @@unique([userId, jobRoleId, hotelId])
  @@index([userId, hotelId])
}

// ─────────────────────────────────────────────────────────────
// 5. SPLIT FOLIOS & ROUTING
// ─────────────────────────────────────────────────────────────
model FolioWindow {
  id            String   @id @default(uuid())
  folioId       String
  folio         Folio    @relation(fields: [folioId], references: [id], onDelete: Cascade)
  windowNumber  Int      @default(1) // Window 1 (Master/Room), Window 2 (Guest/Incidentals), Window 3 (Company), Window 4 (Travel Agent)
  name          String   // e.g. "Room & Tax", "Personal Expenses", "Corporate Billing"
  payerType     String   @default("GUEST") // GUEST, COMPANY, TRAVEL_AGENT
  payerId       String?  // guestId, companyId, or travelAgentId
  balance       Decimal  @default(0) @db.Decimal(18, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  routingRules  FolioRoutingRule[]

  @@unique([folioId, windowNumber])
  @@index([folioId])
}

model FolioRoutingRule {
  id             String      @id @default(uuid())
  folioId        String
  folio          Folio       @relation(fields: [folioId], references: [id], onDelete: Cascade)
  targetWindowId String
  targetWindow   FolioWindow @relation(fields: [targetWindowId], references: [id], onDelete: Cascade)
  chargeCategory String      // ROOM_CHARGE, FOOD_BEVERAGE, AMENITY, MINIBAR, LAUNDRY, SPA, ALL
  createdAt      DateTime    @default(now())

  @@index([folioId, chargeCategory])
}

// ─────────────────────────────────────────────────────────────
// 6. DEPOSITS & NO-SHOWS
// ─────────────────────────────────────────────────────────────
model ReservationDeposit {
  id             String      @id @default(uuid())
  hotelId        String
  hotel          Hotel       @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  reservationId  String
  reservation    Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  amount         Decimal     @db.Decimal(18, 2)
  currency       String      @default("INR")
  paymentMethod  String      // UPI, Card, Cash, BankTransfer
  status         String      @default("REQUIRED") // REQUIRED, RECEIVED, APPLIED, REFUNDED, FORFEITED
  transactionRef String?
  paidAt         DateTime?
  appliedAt      DateTime?
  refundedAt     DateTime?
  forfeitedAt    DateTime?
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([hotelId, status])
  @@index([reservationId])
}

model NoShowRecord {
  id                String      @id @default(uuid())
  hotelId           String
  hotel             Hotel       @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  reservationId     String      @unique
  reservation       Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  noShowDate        DateTime
  noShowFee         Decimal     @default(0) @db.Decimal(18, 2)
  feeBilled         Boolean     @default(false)
  roomReleased      Boolean     @default(true)
  inventoryReopened Boolean     @default(true)
  processedBy       String      // userId
  createdAt         DateTime    @default(now())

  @@index([hotelId, noShowDate])
}

// ─────────────────────────────────────────────────────────────
// 7. WAITLIST & GROUP BLOCKS
// ─────────────────────────────────────────────────────────────
model ReservationWaitlist {
  id             String   @id @default(uuid())
  hotelId        String
  hotel          Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  guestName      String
  guestPhone     String
  guestEmail     String?
  roomCategoryId String?
  arrivalDate    DateTime
  departureDate  DateTime
  numberOfRooms  Int      @default(1)
  priority       Int      @default(1) // 1=Normal, 2=High, 3=VIP
  status         String   @default("ACTIVE") // ACTIVE, CONVERTED, EXPIRED, CANCELLED
  convertedResId String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([hotelId, status, arrivalDate])
}

model GroupBlock {
  id             String   @id @default(uuid())
  hotelId        String
  hotel          Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  groupName      String
  companyName    String?
  contactPerson  String
  contactEmail   String
  contactPhone   String
  startDate      DateTime
  endDate        DateTime
  cutoffDate     DateTime
  totalRooms     Int
  pickedUpRooms  Int      @default(0)
  status         String   @default("DEFINITE") // TENTATIVE, DEFINITE, CANCELLED, RELEASED
  negotiatedRate Decimal  @db.Decimal(18, 2)
  masterFolioId  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  roomingList    GroupRoomingList[]

  @@index([hotelId, status, startDate])
}

model GroupRoomingList {
  id            String     @id @default(uuid())
  groupBlockId  String
  groupBlock    GroupBlock @relation(fields: [groupBlockId], references: [id], onDelete: Cascade)
  guestName     String
  guestEmail    String?
  guestPhone    String?
  roomNumber    String?
  reservationId String?
  status        String     @default("PENDING") // PENDING, RESERVED, CHECKED_IN, CANCELLED
  createdAt     DateTime   @default(now())

  @@index([groupBlockId, status])
}

// ─────────────────────────────────────────────────────────────
// 8. CASHIERING & SHIFTS
// ─────────────────────────────────────────────────────────────
model CashierShift {
  id           String   @id @default(uuid())
  hotelId      String
  hotel        Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  userId       String   // cashier userId
  shiftNumber  Int      @default(1)
  openedAt     DateTime @default(now())
  closedAt     DateTime?
  openingFloat Decimal  @default(0) @db.Decimal(18, 2)
  cashSales    Decimal  @default(0) @db.Decimal(18, 2)
  cashPayments Decimal  @default(0) @db.Decimal(18, 2)
  refunds      Decimal  @default(0) @db.Decimal(18, 2)
  paidOuts     Decimal  @default(0) @db.Decimal(18, 2)
  cashDrops    Decimal  @default(0) @db.Decimal(18, 2)
  expectedCash Decimal  @default(0) @db.Decimal(18, 2)
  actualCash   Decimal? @db.Decimal(18, 2)
  variance     Decimal? @db.Decimal(18, 2)
  status       String   @default("OPEN") // OPEN, CLOSED, AUDITED
  notes        String?
  supervisorId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  transactions CashDrawerTransaction[]

  @@index([hotelId, status])
  @@index([userId, status])
}

model CashDrawerTransaction {
  id          String       @id @default(uuid())
  shiftId     String
  shift       CashierShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  type        String       // OPENING_FLOAT, CASH_SALE, FOLIO_PAYMENT, REFUND, PAID_OUT, CASH_DROP
  amount      Decimal      @db.Decimal(18, 2)
  referenceId String?      // FolioTransactionId, PosOrderId, etc.
  notes       String?
  createdAt   DateTime     @default(now())

  @@index([shiftId, type])
}

// ─────────────────────────────────────────────────────────────
// 9. ACCOUNTS RECEIVABLE (AR) / CITY LEDGER
// ─────────────────────────────────────────────────────────────
model ARAccount {
  id               String   @id @default(uuid())
  hotelId          String
  hotel            Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  accountType      String   // CORPORATE, TRAVEL_AGENT, WHOLESALE
  accountName      String
  accountCode      String
  contactPerson    String
  email            String
  phone            String
  address          String?
  gstin            String?
  creditLimit      Decimal  @default(0) @db.Decimal(18, 2)
  currentBalance   Decimal  @default(0) @db.Decimal(18, 2)
  paymentTermsDays Int      @default(30)
  status           String   @default("ACTIVE") // ACTIVE, SUSPENDED, BLOCKED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  invoices         ARInvoice[]
  payments         ARPayment[]

  @@unique([hotelId, accountCode])
  @@index([hotelId, status])
}

model ARInvoice {
  id            String    @id @default(uuid())
  accountId     String
  account       ARAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  hotelId       String
  invoiceNumber String
  invoiceDate   DateTime
  dueDate       DateTime
  totalAmount   Decimal   @db.Decimal(18, 2)
  paidAmount    Decimal   @default(0) @db.Decimal(18, 2)
  balanceAmount Decimal   @db.Decimal(18, 2)
  status        String    @default("UNPAID") // UNPAID, PARTIAL, PAID, OVERDUE, CANCELLED
  sourceFolioId String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  allocations   ARAllocation[]

  @@unique([hotelId, invoiceNumber])
  @@index([accountId, status])
  @@index([dueDate, status])
}

model ARPayment {
  id                String    @id @default(uuid())
  accountId         String
  account           ARAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  hotelId           String
  paymentNumber     String
  paymentDate       DateTime
  amount            Decimal   @db.Decimal(18, 2)
  unallocatedAmount Decimal   @db.Decimal(18, 2)
  paymentMethod     String    // BANK_TRANSFER, CHEQUE, UPI, CARD
  reference         String?
  notes             String?
  createdAt         DateTime  @default(now())

  allocations       ARAllocation[]

  @@unique([hotelId, paymentNumber])
  @@index([accountId, createdAt])
}

model ARAllocation {
  id        String    @id @default(uuid())
  paymentId String
  payment   ARPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId String
  invoice   ARInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Decimal   @db.Decimal(18, 2)
  createdAt DateTime  @default(now())

  @@index([paymentId])
  @@index([invoiceId])
}

// ─────────────────────────────────────────────────────────────
// 10. ACCOUNTS PAYABLE (AP) & VENDOR LEDGER
// ─────────────────────────────────────────────────────────────
model VendorAccount {
  id               String   @id @default(uuid())
  hotelId          String
  hotel            Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  vendorName       String
  vendorCode       String
  category         String   // FNB_SUPPLIER, LINEN_SUPPLIER, MAINTENANCE, UTILITIES, AMENITIES, IT_SERVICES
  contactPerson    String
  email            String
  phone            String
  address          String?
  gstin            String?
  bankDetails      Json?
  currentBalance   Decimal  @default(0) @db.Decimal(18, 2)
  paymentTermsDays Int      @default(30)
  status           String   @default("ACTIVE") // ACTIVE, INACTIVE, BLOCKED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  purchaseOrders   PurchaseOrder[]
  apInvoices       APInvoice[]
  apPayments       APPayment[]

  @@unique([hotelId, vendorCode])
  @@index([hotelId, status])
}

model APInvoice {
  id              String        @id @default(uuid())
  vendorId        String
  vendor          VendorAccount @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  hotelId         String
  invoiceNumber   String
  invoiceDate     DateTime
  dueDate         DateTime
  poId            String?
  grnId           String?
  totalAmount     Decimal       @db.Decimal(18, 2)
  paidAmount      Decimal       @default(0) @db.Decimal(18, 2)
  balanceAmount   Decimal       @db.Decimal(18, 2)
  status          String        @default("UNPAID") // UNPAID, PARTIAL, PAID, DISPUTED
  threeWayMatched Boolean       @default(false)
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  allocations     APAllocation[]

  @@unique([hotelId, invoiceNumber])
  @@index([vendorId, status])
  @@index([dueDate, status])
}

model APPayment {
  id                String        @id @default(uuid())
  vendorId          String
  vendor            VendorAccount @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  hotelId           String
  paymentNumber     String
  paymentDate       DateTime
  amount            Decimal       @db.Decimal(18, 2)
  unallocatedAmount Decimal       @db.Decimal(18, 2)
  paymentMethod     String        // BANK_TRANSFER, CHEQUE, UPI
  reference         String?
  notes             String?
  createdAt         DateTime      @default(now())

  allocations       APAllocation[]

  @@unique([hotelId, paymentNumber])
  @@index([vendorId, createdAt])
}

model APAllocation {
  id        String    @id @default(uuid())
  paymentId String
  payment   APPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId String
  invoice   APInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Decimal   @db.Decimal(18, 2)
  createdAt DateTime  @default(now())

  @@index([paymentId])
  @@index([invoiceId])
}

// ─────────────────────────────────────────────────────────────
// 11. ENGINEERING & MAINTENANCE
// ─────────────────────────────────────────────────────────────
model MaintenanceAsset {
  id             String   @id @default(uuid())
  hotelId        String
  hotel          Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name           String   // e.g. "Chiller Unit 1", "Elevator A", "Generator 500kVA", "Boiler 2"
  code           String
  category       String   // HVAC, ELECTRICAL, PLUMBING, ELEVATOR, GENERATOR, KITCHEN_EQUIPMENT, FIRE_SAFETY
  location       String   // Basement, Rooftop, Floor 3, Kitchen
  serialNumber   String?
  modelNumber    String?
  purchaseDate   DateTime?
  warrantyExpiry DateTime?
  status         String   @default("OPERATIONAL") // OPERATIONAL, UNDER_MAINTENANCE, BREAKDOWN, RETIRED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workOrders     WorkOrder[]
  schedules      PreventiveMaintenanceSchedule[]

  @@unique([hotelId, code])
  @@index([hotelId, status])
}

model WorkOrder {
  id                 String   @id @default(uuid())
  hotelId            String
  hotel              Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  assetId            String?
  asset              MaintenanceAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)
  roomId             String?
  workOrderNumber    String
  title              String
  description        String
  priority           String   @default("MEDIUM") // LOW, MEDIUM, HIGH, EMERGENCY
  category           String   // CORRECTIVE, PREVENTIVE, GUEST_REPORTED
  status             String   @default("REPORTED") // REPORTED, ASSIGNED, IN_PROGRESS, WAITING_PARTS, COMPLETED, VERIFIED, CLOSED
  assignedTo         String?  // technician userId
  reportedBy         String   // userId
  startedAt          DateTime?
  completedAt        DateTime?
  costEstimate       Decimal? @db.Decimal(18, 2)
  actualCost         Decimal? @db.Decimal(18, 2)
  lockRoomOutOfOrder Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  partsUsed          WorkOrderPart[]

  @@unique([hotelId, workOrderNumber])
  @@index([hotelId, status, priority])
  @@index([hotelId, roomId])
}

model WorkOrderPart {
  id          String    @id @default(uuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  partName    String
  quantity    Int       @default(1)
  unitCost    Decimal   @db.Decimal(18, 2)
  totalCost   Decimal   @db.Decimal(18, 2)
  createdAt   DateTime  @default(now())

  @@index([workOrderId])
}

model PreventiveMaintenanceSchedule {
  id           String           @id @default(uuid())
  assetId      String
  asset        MaintenanceAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  hotelId      String
  hotel        Hotel            @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  title        String
  frequency    String           // DAILY, WEEKLY, MONTHLY, QUARTERLY, ANNUALLY
  lastRunDate  DateTime?
  nextRunDate  DateTime
  assignedRole String           @default("TECHNICIAN")
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([hotelId, nextRunDate, isActive])
}

// ─────────────────────────────────────────────────────────────
// 12. PROCUREMENT & PURCHASING
// ─────────────────────────────────────────────────────────────
model PurchaseRequisition {
  id            String   @id @default(uuid())
  hotelId       String
  hotel         Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  prNumber      String
  department    String
  requestedBy   String   // userId
  estimatedCost Decimal  @db.Decimal(18, 2)
  status        String   @default("DRAFT") // DRAFT, SUBMITTED, APPROVED, REJECTED, CONVERTED_TO_PO
  approvalReqId String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items         PurchaseRequisitionItem[]
  purchaseOrders PurchaseOrder[]

  @@unique([hotelId, prNumber])
  @@index([hotelId, status])
}

model PurchaseRequisitionItem {
  id                String              @id @default(uuid())
  prId              String
  requisition       PurchaseRequisition @relation(fields: [prId], references: [id], onDelete: Cascade)
  itemName          String
  quantity          Decimal             @db.Decimal(18, 2)
  unit              String
  estimatedUnitCost Decimal             @db.Decimal(18, 2)
  totalCost         Decimal             @db.Decimal(18, 2)
  createdAt         DateTime            @default(now())

  @@index([prId])
}

model PurchaseOrder {
  id            String              @id @default(uuid())
  hotelId       String
  hotel         Hotel               @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  vendorId      String
  vendor        VendorAccount       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  prId          String?
  requisition   PurchaseRequisition? @relation(fields: [prId], references: [id], onDelete: SetNull)
  poNumber      String
  poDate        DateTime            @default(now())
  expectedDate  DateTime?
  subtotal      Decimal             @db.Decimal(18, 2)
  taxAmount     Decimal             @db.Decimal(18, 2)
  totalAmount   Decimal             @db.Decimal(18, 2)
  status        String              @default("DRAFT") // DRAFT, APPROVED, ORDERED, PARTIAL_RECEIVED, RECEIVED, CLOSED, CANCELLED
  approvedBy    String?
  notes         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  items         PurchaseOrderItem[]
  goodsReceipts GoodsReceiptNote[]

  @@unique([hotelId, poNumber])
  @@index([hotelId, status])
  @@index([vendorId, status])
}

model PurchaseOrderItem {
  id            String        @id @default(uuid())
  poId          String
  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  itemName      String
  orderedQty    Decimal       @db.Decimal(18, 2)
  receivedQty   Decimal       @default(0) @db.Decimal(18, 2)
  unit          String
  unitPrice     Decimal       @db.Decimal(18, 2)
  taxPercent    Decimal       @default(0) @db.Decimal(18, 2)
  totalPrice    Decimal       @db.Decimal(18, 2)
  createdAt     DateTime      @default(now())

  @@index([poId])
}

model GoodsReceiptNote {
  id            String        @id @default(uuid())
  hotelId       String
  hotel         Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  poId          String
  po            PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  grnNumber     String
  receivedDate  DateTime      @default(now())
  receivedBy    String        // userId
  status        String        @default("RECEIVED") // RECEIVED, QUALITY_CHECKED, ACCEPTED, REJECTED
  invoiceNumber String?
  notes         String?
  createdAt     DateTime      @default(now())

  items         GoodsReceiptItem[]

  @@unique([hotelId, grnNumber])
  @@index([hotelId, poId])
}

model GoodsReceiptItem {
  id          String           @id @default(uuid())
  grnId       String
  grn         GoodsReceiptNote @relation(fields: [grnId], references: [id], onDelete: Cascade)
  itemName    String
  receivedQty Decimal          @db.Decimal(18, 2)
  acceptedQty Decimal          @db.Decimal(18, 2)
  rejectedQty Decimal          @default(0) @db.Decimal(18, 2)
  unitPrice   Decimal          @db.Decimal(18, 2)
  createdAt   DateTime         @default(now())

  @@index([grnId])
}

// ─────────────────────────────────────────────────────────────
// 13. MULTI-STORE INVENTORY & TRANSFERS
// ─────────────────────────────────────────────────────────────
model InventoryStore {
  id            String   @id @default(uuid())
  hotelId       String
  hotel         Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name          String   // Central Store, Kitchen Store, Housekeeping Store, Linen Store, Main Bar Store
  code          String
  location      String?
  storekeeperId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  outgoingTransfers StockTransfer[] @relation("SourceStore")
  incomingTransfers StockTransfer[] @relation("DestinationStore")

  @@unique([hotelId, code])
  @@index([hotelId])
}

model StockTransfer {
  id             String         @id @default(uuid())
  hotelId        String
  hotel          Hotel          @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  transferNumber String
  sourceStoreId  String
  sourceStore    InventoryStore @relation("SourceStore", fields: [sourceStoreId], references: [id], onDelete: Cascade)
  destStoreId    String
  destStore      InventoryStore @relation("DestinationStore", fields: [destStoreId], references: [id], onDelete: Cascade)
  itemName       String
  quantity       Decimal        @db.Decimal(18, 2)
  unit           String
  status         String         @default("REQUESTED") // REQUESTED, IN_TRANSIT, RECEIVED, REJECTED
  requestedBy    String
  receivedBy     String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([hotelId, transferNumber])
  @@index([hotelId, status])
}

// ─────────────────────────────────────────────────────────────
// 14. LINEN & MINIBAR
// ─────────────────────────────────────────────────────────────
model LinenItem {
  id          String   @id @default(uuid())
  hotelId     String
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name        String   // King Bed Sheet, Pillowcase, Bath Towel, Hand Towel, Bath Mat, Duvet Cover
  code        String
  parStock    Int      @default(0)
  totalStock  Int      @default(0)
  inRooms     Int      @default(0)
  inLinenRoom Int      @default(0)
  inLaundry   Int      @default(0)
  damaged     Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([hotelId, code])
  @@index([hotelId])
}

model MinibarItem {
  id              String   @id @default(uuid())
  hotelId         String
  hotel           Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name            String   // Sparkling Water, Premium Soda, Chocolate Bar, Roasted Nuts, Energy Drink
  code            String
  price           Decimal  @db.Decimal(18, 2)
  costPrice       Decimal  @db.Decimal(18, 2)
  stockQty        Int      @default(0)
  isComplimentary Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  consumptions    MinibarConsumption[]

  @@unique([hotelId, code])
  @@index([hotelId])
}

model MinibarConsumption {
  id            String      @id @default(uuid())
  hotelId       String
  hotel         Hotel       @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomId        String
  reservationId String
  minibarItemId String
  minibarItem   MinibarItem @relation(fields: [minibarItemId], references: [id], onDelete: Cascade)
  quantity      Int         @default(1)
  unitPrice     Decimal     @db.Decimal(18, 2)
  totalAmount   Decimal     @db.Decimal(18, 2)
  folioId       String?
  postedToFolio Boolean     @default(false)
  recordedBy    String      // userId
  createdAt     DateTime    @default(now())

  @@index([hotelId, roomId, reservationId])
}

// ─────────────────────────────────────────────────────────────
// 15. CHANNEL MANAGER & OTA DISTRIBUTION
// ─────────────────────────────────────────────────────────────
model ChannelConnection {
  id               String   @id @default(uuid())
  hotelId          String
  hotel            Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  channelCode      String   // BOOKING_COM, EXPEDIA, AGODA, AIRBNB, MAKEMYTRIP, GOIBIBO
  channelName      String
  apiKey           String?
  apiSecret        String?
  hotelIdOnChannel String
  isActive         Boolean  @default(true)
  syncStatus       String   @default("IDLE") // IDLE, SYNCING, ERROR
  lastSyncAt       DateTime?
  errorMessage     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  roomMappings     ChannelRoomMapping[]
  rateMappings     ChannelRateMapping[]
  syncJobs         ChannelSyncJob[]

  @@unique([hotelId, channelCode])
  @@index([hotelId, isActive])
}

model ChannelRoomMapping {
  id              String            @id @default(uuid())
  connectionId    String
  connection      ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  roomCategoryId  String
  channelRoomId   String
  channelRoomName String
  createdAt       DateTime          @default(now())

  @@unique([connectionId, roomCategoryId])
  @@index([connectionId])
}

model ChannelRateMapping {
  id              String            @id @default(uuid())
  connectionId    String
  connection      ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  ratePlanId      String
  channelRateId   String
  channelRateName String
  multiplier      Decimal           @default(1.0) @db.Decimal(18, 4)
  createdAt       DateTime          @default(now())

  @@unique([connectionId, ratePlanId])
  @@index([connectionId])
}

model ChannelSyncJob {
  id           String            @id @default(uuid())
  connectionId String
  connection   ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  jobType      String            // AVAILABILITY_PUSH, RATE_PUSH, RESTRICTION_PUSH, RESERVATION_PULL
  status       String            @default("PENDING") // PENDING, PROCESSING, SUCCESS, FAILED
  payload      Json?
  errorMessage String?
  durationMs   Int?
  createdAt    DateTime          @default(now())

  @@index([connectionId, status])
}

model ChannelReservation {
  id               String      @id @default(uuid())
  hotelId          String
  hotel            Hotel       @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  channelCode      String
  channelBookingId String
  reservationId    String?     @unique
  reservation      Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  guestName        String
  guestEmail       String?
  arrivalDate      DateTime
  departureDate    DateTime
  totalAmount      Decimal     @db.Decimal(18, 2)
  commissionAmount Decimal     @default(0) @db.Decimal(18, 2)
  status           String      // CONFIRMED, MODIFIED, CANCELLED
  rawPayload       Json?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@unique([hotelId, channelCode, channelBookingId])
  @@index([hotelId, channelCode])
}

// ─────────────────────────────────────────────────────────────
// 16. CORPORATE CRM & CONTRACTS
// ─────────────────────────────────────────────────────────────
model CorporateLead {
  id             String   @id @default(uuid())
  hotelId        String
  hotel          Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  companyName    String
  contactName    String
  contactEmail   String
  contactPhone   String
  estimatedValue Decimal? @db.Decimal(18, 2)
  stage          String   @default("LEAD") // LEAD, QUALIFIED, PROPOSAL, NEGOTIATION, WON, LOST
  assignedTo     String?  // userId
  lostReason     String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  contracts      CorporateContract[]

  @@index([hotelId, stage])
}

model CorporateContract {
  id                 String         @id @default(uuid())
  hotelId            String
  hotel              Hotel          @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  leadId             String?
  lead               CorporateLead? @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contractNumber     String
  companyName        String
  startDate          DateTime
  endDate            DateTime
  negotiatedDiscount Decimal        @default(0) @db.Decimal(18, 2)
  fixedRoomRate      Decimal?       @db.Decimal(18, 2)
  minimumNights      Int            @default(0)
  creditLimit        Decimal        @default(0) @db.Decimal(18, 2)
  paymentTerms       String         @default("NET_30")
  status             String         @default("ACTIVE") // DRAFT, ACTIVE, EXPIRED, TERMINATED
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@unique([hotelId, contractNumber])
  @@index([hotelId, status])
}

// ─────────────────────────────────────────────────────────────
// 17. GUEST COMMUNICATIONS & TEMPLATES
// ─────────────────────────────────────────────────────────────
model MessageTemplate {
  id        String   @id @default(uuid())
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name      String   // Booking Confirmation, Check-in Reminder, Welcome Message, Invoice Receipt, Feedback Request
  channel   String   // EMAIL, SMS, WHATSAPP
  subject   String?
  body      String   // Template with {{guestName}}, {{hotelName}}, {{arrivalDate}}, etc.
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hotelId, name, channel])
  @@index([hotelId, isActive])
}

model GuestMessageLog {
  id            String   @id @default(uuid())
  hotelId       String
  hotel         Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  guestId       String?
  reservationId String?
  channel       String   // EMAIL, SMS, WHATSAPP
  recipient     String
  subject       String?
  messageBody   String
  status        String   @default("SENT") // PENDING, SENT, DELIVERED, FAILED
  providerRef   String?
  errorMessage  String?
  createdAt     DateTime @default(now())

  @@index([hotelId, channel, status])
  @@index([reservationId])
}

// ─────────────────────────────────────────────────────────────
// 18. LOYALTY 2.0 DOUBLE-ENTRY LEDGER
// ─────────────────────────────────────────────────────────────
model LoyaltyTier {
  id             String   @id @default(uuid())
  name           String   // SILVER, GOLD, PLATINUM, DIAMOND
  minPoints      Int      @default(0)
  discountPercent Decimal @default(0) @db.Decimal(18, 2)
  perks          Json?
  createdAt      DateTime @default(now())
}

model LoyaltyAccount {
  id             String   @id @default(uuid())
  hotelId        String
  hotel          Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  guestId        String   @unique
  memberNumber   String
  tier           String   @default("SILVER") // SILVER, GOLD, PLATINUM, DIAMOND
  pointsBalance  Int      @default(0)
  lifetimePoints Int      @default(0)
  joinedAt       DateTime @default(now())
  updatedAt      DateTime @updatedAt

  transactions   LoyaltyPointTransaction[]

  @@unique([hotelId, memberNumber])
  @@index([hotelId, tier])
}

model LoyaltyPointTransaction {
  id           String         @id @default(uuid())
  accountId    String
  account      LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type         String         // EARNED, REDEEMED, EXPIRED, ADJUSTMENT, BONUS
  points       Int            // Positive for Earned/Bonus, Negative for Redeemed/Expired
  balanceAfter Int
  referenceId  String?        // FolioId, ReservationId
  description  String
  createdAt    DateTime       @default(now())

  @@index([accountId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// 19. REPUTATION, CSAT & SERVICE RECOVERY
// ─────────────────────────────────────────────────────────────
model GuestFeedbackSurvey {
  id                String   @id @default(uuid())
  hotelId           String
  hotel             Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  reservationId     String?
  guestName         String
  guestEmail        String?
  rating            Int      // 1 to 5
  npsScore          Int?     // 0 to 10
  cleanlinessRating Int?
  staffRating       Int?
  foodRating        Int?
  comments          String?
  status            String   @default("NEW") // NEW, REVIEWED, ESCALATED, RESOLVED
  createdAt         DateTime @default(now())

  recoveryTicket    ServiceRecoveryTicket?

  @@index([hotelId, rating])
  @@index([hotelId, status])
}

model ServiceRecoveryTicket {
  id                  String              @id @default(uuid())
  feedbackId          String              @unique
  feedback            GuestFeedbackSurvey @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  hotelId             String
  hotel               Hotel               @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  issueDescription    String
  compensationOffered String?             // e.g. "Free Breakfast Voucher", "10% Room Discount", "Late Checkout"
  compensationAmount  Decimal?            @db.Decimal(18, 2)
  assignedTo          String?             // userId
  status              String              @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  resolutionNotes     String?
  resolvedAt          DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([hotelId, status])
}

// ─────────────────────────────────────────────────────────────
// 20. REVENUE MANAGEMENT & RESTRICTIONS
// ─────────────────────────────────────────────────────────────
model RateRestriction {
  id                String   @id @default(uuid())
  hotelId           String
  hotel             Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomCategoryId    String?
  ratePlanId        String?
  date              DateTime
  minLOS            Int      @default(1)
  maxLOS            Int?
  closedToArrival   Boolean  @default(false)
  closedToDeparture Boolean  @default(false)
  stopSell          Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([hotelId, roomCategoryId, ratePlanId, date])
  @@index([hotelId, date])
}

// ─────────────────────────────────────────────────────────────
// 21. MULTI-CURRENCY
// ─────────────────────────────────────────────────────────────
model CurrencyRate {
  id            String   @id @default(uuid())
  hotelId       String
  hotel         Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  currencyCode  String   // USD, EUR, GBP, AED, SGD, JPY, AUD
  rateToBase    Decimal  @db.Decimal(18, 6) // e.g. 1 USD = 83.50 INR
  effectiveDate DateTime
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([hotelId, currencyCode, effectiveDate])
  @@index([hotelId, currencyCode])
}
